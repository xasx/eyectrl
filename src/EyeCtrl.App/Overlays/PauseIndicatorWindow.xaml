<overlay:OverlayWindow x:Class="EyeCtrl.App.Overlays.PauseIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:EyeCtrl.App.Overlays"
        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
        AutomationProperties.AutomationId="PauseIndicator_Window"
        Title="{loc:T 'overlays.pause.title'}"
        Topmost="True"
        ShowInTaskbar="False"
        IsClickThrough="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <!-- B2a: the strip, the state label and the Resume disc share one canvas, laid out by
         ResumeStripLayout in window coordinates. The window stays click-through: Resume is a
         gaze dwell (its own detector in ResumeStripViewModel), never a mouse target, so nothing
         here is hit-testable. Constant appearance, no animation (debate #5). -->
    <Canvas x:Name="StripCanvas" IsHitTestVisible="False">
        <!-- The strip: accent with a halo edge, so it reads on any desktop content. -->
        <Border x:Name="StripBar"
                Background="{StaticResource BrushAccent}"
                BorderBrush="{StaticResource BrushStrokeHalo}"
                BorderThickness="{StaticResource StandardBorderThickness}"/>

        <!-- The state label, shown with the Resume disc. Fixed box (ResumeStripLayout.LabelWidthDip
             x LabelHeightDip) so the fit measurer can bound it. -->
        <Border x:Name="StateLabelCard" Visibility="Collapsed"
                Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushAccent}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                CornerRadius="{StaticResource StandardCornerRadius}">
            <TextBlock x:Name="StateLabel" Text="{loc:T 'overlays.pause.label'}"
                       Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeSubtitle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
        </Border>

        <!-- The Resume disc: an icon-only DwellArcButton (play glyph) built in code at the layout's
             centre, with its UIA name on the button's automation anchor. -->
        <Canvas x:Name="ResumeLayer" Visibility="Collapsed"/>
    </Canvas>
</overlay:OverlayWindow>
