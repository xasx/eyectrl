<!-- NoResize: AllowsTransparency=False gives this window a real frame, and the default CanResize
     adds an invisible 6-DIP resize border — the client area then starts inside the window origin,
     but the ✕ and the dark fill are computed FROM the window origin, so they were drawn 6 DIP right
     and below their places (EdgeButtonBarWindow.xaml does the same). -->
<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.GlassBackdropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False">
    <Grid>
        <Canvas x:Name="BackdropCanvas" IsHitTestVisible="False"/>

        <!-- Escape hint: mirrors CalibrationWindow's CancelHint (placement, wording, styling), so a
             caregiver who does not recognise the dwell-driven Close button still finds a way out
             that does not need the user's gaze. Collapsed by default; ShowEscapeHint/HideEscapeHint
             toggle it. This window already excludes itself from screen capture (ExcludeFromScreenCapture
             below), so the hint never gets baked into the manual-selection magnifier's captured image. -->
        <TextBlock x:Name="EscapeHint" Foreground="{StaticResource BrushTextDim}" FontSize="{StaticResource FontSizeBody}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,20,20" Visibility="Collapsed" IsHitTestVisible="False"
                   Text="{loc:T 'overlays.hint.pressEscToExit'}"/>
    </Grid>
</overlays:OverlayWindow>
