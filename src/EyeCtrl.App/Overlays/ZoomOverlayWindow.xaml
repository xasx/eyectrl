<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.ZoomOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    <Grid>
        <Ellipse x:Name="ClipEllipse">
            <Ellipse.Fill>
                <ImageBrush x:Name="ZoomBrush" Stretch="Fill"/>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Stroke="White" StrokeThickness="2" IsHitTestVisible="False"/>
    </Grid>
</overlays:OverlayWindow>
