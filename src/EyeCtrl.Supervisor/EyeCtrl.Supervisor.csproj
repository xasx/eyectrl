<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <StartupObject>EyeCtrl.Supervisor.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EyeCtrl.Core\EyeCtrl.Core.csproj" />
    <ProjectReference Include="..\EyeCtrl.Platform\EyeCtrl.Platform.csproj" />
    <ProjectReference Include="..\EyeCtrl.Controls\EyeCtrl.Controls.csproj" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EyeCtrl.Supervisor.Tests" />
    <!-- For InstanceScopeEnvVarTests: this project cannot reference EyeCtrl.Contracts without
         breaking LayeringTests, so ProcessController.InstanceScopeEnvVarName is a literal.
         Architecture.Tests is the only project referencing both and so the only place the literal
         and InstanceScope.EnvVar can be compared. Visibility only — no new ProjectReference, so
         the pinned dependency graph is untouched. -->
    <InternalsVisibleTo Include="EyeCtrl.Architecture.Tests" />
  </ItemGroup>
</Project>
