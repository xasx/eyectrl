<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.DriftNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="DriftNotice_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="560" Height="72">
    <Grid>
        <!-- BorderThickness="1" mirrors Tokens.BorderThicknessStandard; a double
             token cannot be consumed as a WPF Thickness via StaticResource, so the
             value is stated here rather than referenced. -->
        <Border x:Name="Banner"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="6" Padding="18,10" Opacity="0">
            <TextBlock x:Name="Message"
                       AutomationProperties.AutomationId="DriftNotice_Message"
                       Foreground="{StaticResource BrushTextPrimary}" FontSize="18" TextAlignment="Center"
                       Text="Tracking may have drifted — consider re-calibrating"/>
        </Border>
    </Grid>
</overlays:OverlayWindow>
