<local:OverlayWindow x:Class="EyeCtrl.App.Overlays.EyeCareBannerWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:EyeCtrl.App.Overlays"
                     xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
                     WindowStyle="None" AllowsTransparency="True"
                     Topmost="True" ShowInTaskbar="False"
                     Background="Transparent"
                     Width="{x:Static SystemParameters.PrimaryScreenWidth}"
                     Height="312"
                     Left="0" Top="0">

    <Grid>
        <!-- Dim the work area below the banner (click-through) -->
        <Rectangle x:Name="WorkDim" Fill="{StaticResource BrushModalBackdrop}" Visibility="Collapsed"/>

        <!-- The message strip. 96 since T13 fixup-03 (it held the ring captions at 80); it stays
             the top band now that B7 moved the rings out of it, because the height is a decided
             part of the banner's look and nothing below depends on it. -->
        <Border VerticalAlignment="Top" Height="96" Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="MessageText"
                               Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="{StaticResource FontWeightMedium}"/>
                    <TextBlock x:Name="SubText" Text="{loc:T 'eye-care.banner.subtext'}"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The two dwell discs. They sit BELOW the toolbar band (code sets RingLayer's top
             margin: RingTopDip) and fully inset from the right edge, so neither hugs the top edge
             where tracking is worst. Laid out, not Canvas-positioned: the right-anchored panel
             turns the same constants (right inset, 100 DIP disc, 24 DIP gap) into DIP, so the
             drawn circle is the registered r50 hit circle at whatever the window's width is. The
             ✕/▶ glyph sizes are set in the constructor as a ratio of the 100 DIP ring — XAML
             cannot express the multiplication. -->
        <StackPanel x:Name="RingLayer" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,168,20,0">
            <Grid x:Name="SnoozeRingBox" Width="100" Height="100" Margin="0,0,24,0">
                <Ellipse x:Name="SnoozeRing" Stroke="{StaticResource BrushTextDim}" StrokeThickness="2" StrokeDashArray="3 3" Opacity="0.7"/>
                <TextBlock x:Name="SnoozeGlyph" Text="✕" Foreground="{StaticResource BrushTextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="SnoozeLabel" Text="{loc:T 'eye-care.banner.snooze'}" Foreground="{StaticResource BrushTextDim}" FontSize="{StaticResource FontSizeBody}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-16"/>
            </Grid>
            <Grid x:Name="StartRingBox" Width="100" Height="100">
                <Ellipse x:Name="StartRing" Stroke="{StaticResource BrushAccent}" StrokeThickness="2" StrokeDashArray="3 3" Opacity="0.7"/>
                <TextBlock x:Name="StartGlyph" Text="▶" Foreground="{StaticResource BrushAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="StartLabel" Text="{loc:T 'eye-care.banner.start'}" Foreground="{StaticResource BrushAccent}" FontSize="{StaticResource FontSizeBody}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-16"/>
            </Grid>
        </StackPanel>
    </Grid>
</local:OverlayWindow>
