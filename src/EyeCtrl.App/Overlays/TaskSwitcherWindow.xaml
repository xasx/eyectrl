<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.TaskSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
        xmlns:ctl="clr-namespace:EyeCtrl.Controls;assembly=EyeCtrl.Controls"
        AutomationProperties.AutomationId="TaskSwitcher_Window"
        Title="{loc:T 'overlays.toolbar.taskSwitcher'}"
        WindowStyle="None" AllowsTransparency="False" Background="{StaticResource BrushSurfaceDarkOpaque}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        IsClickThrough="False">
    <overlays:OverlayWindow.Resources>
        <!-- The three new states are boolean VM flags; WPF has no implicit bool-to-Visibility
             conversion, and a window-local converter keeps them declarative (the codebase's other
             state cues are single-property writes, so no style/trigger machinery is needed). -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </overlays:OverlayWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" x:Name="TilesScroll" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- PanelItems, not Tiles: it is the window tiles plus the session's "Show desktop"
                 tile (always last). Tiles stays the window-only list the counts, badges and the
                 overflow chip are built on. -->
            <ItemsControl x:Name="TilesPanel" AutomationProperties.AutomationId="TaskSwitcher_Tiles" ItemsSource="{Binding PanelItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="216" ItemHeight="182"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- S3-A: the desktop tile is OUTLINED where a window tile is FILLED, and
                             carries its own glyph + label instead of an icon + title. The style (not
                             local attributes) owns Background/BorderThickness: a local value would
                             win over the DataTrigger and the tile would stay a filled window tile.
                             BorderThickness draws INSIDE the 184x150 face (216 x 182 cell less the
                             template's 16 DIP margin, F-GAP), so the drawn tile — and therefore the
                             dwell target the View registers — is the same size. -->
                        <Border x:Name="TileFace" Margin="16" CornerRadius="{StaticResource StandardCornerRadius}" Padding="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushSurfaceMedium}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDesktop}" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                                            <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="WindowContent" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Hidden on the desktop tile; the default lives in the style
                                         because a local Visibility would beat the trigger. -->
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDesktop}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- S4-C: the LIVE PREVIEW BOX, 168 x 94 DIP (the ticket's Option C
                                         board). DWM draws the tile's thumbnail ABOVE every WPF pixel of
                                         this window, into exactly this rectangle — so this box must stay
                                         EMPTY of anything that has to be read while a preview is up:
                                         the title, icon row, badge and progress bar all live outside
                                         it. The box's own background is SurfaceLight, which is what the
                                         picture's letterbox bars show; ClipToBounds is for the fallback,
                                         not for DWM (a thumbnail is composed above WPF and is kept inside
                                         this rect by ThumbnailGeometry, never by a WPF clip).
                                         PreviewFallback is collapsed as soon as the View registered a
                                         thumbnail (HasPreview): a DWM thumbnail covers WPF content, and a
                                         fallback left underneath would flash on a failed re-register. -->
                                    <Border x:Name="PreviewBox" Width="168" Height="94"
                                            Background="{StaticResource BrushSurfaceLight}"
                                            CornerRadius="{StaticResource SmallCornerRadius}"
                                            ClipToBounds="True">
                                        <Grid x:Name="PreviewFallback">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- The fallback: a minimised window (never a thumbnail —
                                                     DWM has no live picture of an iconic window), or a window
                                                     whose registration failed. 40 DIP with HighQuality
                                                     scaling, the S3-B source size rule. -->
                                                <Image x:Name="PreviewIcon" Source="{Binding Icon}" Width="40" Height="40"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <!-- S2-B/S4-C: the "Minimiert" badge lives INSIDE the preview
                                                     box on a minimised tile, below its icon — the only state
                                                     that has no live picture, so the box is where the badge is
                                                     read. It keeps HorizontalAlignment=Center so it hugs its
                                                     own content instead of stretching into a light band. -->
                                                <Border x:Name="MinimizedBadge" Margin="0,4,0,0" Padding="6,0"
                                                        HorizontalAlignment="Center"
                                                        Background="{StaticResource BrushSurfaceMedium}"
                                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                                        Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <!-- The mark is DRAWN, not typeset: a low bar is the minimise
                                                             shape, no font in the standard face provides one (U+2581
                                                             falls back to a hairline), and the emoji-presentation
                                                             U+1F5D5 is what Emoji.Wpf substitutes — the drawn arrow in
                                                             the emoji grid's back key is the same deliberate choice. -->
                                                        <Border x:Name="MinimizedGlyph" Width="10" Height="2"
                                                                Background="{StaticResource BrushTextSecondary}"
                                                                VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{loc:T 'overlays.taskSwitcher.minimized'}"
                                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                                   FontSize="{StaticResource FontSizeBody}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- S4-C: the identity row — the app icon at 20 DIP (the preview above
                                         carries the 40 DIP fallback) and the title, LEFT-aligned beside it
                                         and trimmed to the 168 DIP content width (the Option C board: a
                                         trimmed title reads from its start, so short titles do not jump to
                                         the middle under the picture). -->
                                    <StackPanel x:Name="TileRow" Orientation="Horizontal" Margin="0,6,0,0"
                                                HorizontalAlignment="Stretch">
                                        <Image x:Name="TileIcon" Source="{Binding Icon}" Width="20" Height="20"
                                               Margin="0,0,6,0" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="142" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- S3-A: the desktop tile's own content. Drawn, not typeset: a monitor
                                     outline on the icon grid (screen, stand, base), the same shape
                                     language the toolbar icons use. 40 DIP keeps it the same visual
                                     weight as a 32 DIP process icon plus its caption. -->
                                <StackPanel x:Name="DesktopContent" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDesktop}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Viewbox Width="40" Height="40" Margin="0,0,0,4">
                                        <Path Width="24" Height="24"
                                              Data="M4.2,4.4 L19.8,4.4 A1.6,1.6 0 0 1 21.4,6 L21.4,15 A1.6,1.6 0 0 1 19.8,16.6 L4.2,16.6 A1.6,1.6 0 0 1 2.6,15 L2.6,6 A1.6,1.6 0 0 1 4.2,4.4 Z M12,16.6 L12,20.4 M8.4,20.4 L15.6,20.4"
                                              Stroke="{StaticResource BrushTextSecondary}" StrokeThickness="1.4"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock x:Name="DesktopLabel" Text="{loc:T 'overlays.taskSwitcher.desktop'}"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <!-- Dwell progress: without it a tile gives NO feedback while a
                                     700ms dwell builds, which reads as "not dwellable" (2026-08-17
                                     field report) — every other dwell surface in the app shows this. -->
                                <ProgressBar x:Name="WindowProgress" Grid.Row="1" Value="{Binding DwellProgress}" Maximum="1" Minimum="0"
                                             Height="6" Margin="0,4,0,0"
                                             Foreground="{StaticResource BrushAccent}" Background="Transparent"
                                             BorderThickness="0" Focusable="False" IsHitTestVisible="False"
                                             Opacity="{Binding IsDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- S2-B: no window to offer (more likely since S2-A leaves the foreground window out).
             Centred where the tile block would be — the Margin mirrors the tile viewport's, so it
             follows the docked toolbar keep-out without a second geometry source. No dwell target:
             nothing here is registered, and the ✕ below stays the escape. -->
        <TextBlock x:Name="EmptyMessage" Grid.Row="0"
                   Text="{loc:T 'overlays.taskSwitcher.empty'}"
                   Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBodyLarge}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   Margin="{Binding Margin, ElementName=TilesScroll}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        <Grid Grid.Row="1" x:Name="HintRow">
            <!-- F-CORNER: the hint row is TEXT ONLY now. The ✕ moved to the window's top-right
                 corner (the backdrop hide ✕'s 53 DIP inset), so this row reserves only what the
                 hint text needs: one 18.62 DIP line plus its 12 DIP top/bottom margins = 42.62
                 DIP, pinned by TaskSwitcherLayout.HintRowHeight and held against WPF's own
                 layout by TaskSwitcherWindowLayoutTests. The freed 81 DIP went into the tile
                 area, which is what let a fifth row survive under a 200 DIP band.

                 S2-B fixup-01: the row is THREE columns — the chip lives in the left STAR column,
                 the hint in the middle Auto column — so showing the chip can never move the hint.
                 The two star columns are equal, which centres the Auto column exactly as the
                 single centred StackPanel was centred before. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- S2-B overflow chip: windows enumerated beyond the grid's capacity have no tile, so
                 the row says how many. It sits in the LEFT star column, right-aligned 32 DIP from
                 that column's end — i.e. 32 DIP left of the hint's left edge. The ✕ is now in the
                 opposite (top-right) corner, so the chip's distance from it is the whole screen
                 diagonal; the old 100 DIP clearance rule survives trivially, and the chip's
                 vertical margins dropped to zero so it fits the text-height row. It never changes
                 a column's size: the star column absorbs it. Not a dwell target. -->
            <Border x:Name="OverflowChip" Grid.Column="0" HorizontalAlignment="Right"
                    Margin="0,0,32,0" Padding="12,4"
                    VerticalAlignment="Center" IsHitTestVisible="False"
                    Background="{StaticResource BrushSurfaceLight}"
                    CornerRadius="{StaticResource StandardCornerRadius}"
                    Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OverflowCount, StringFormat={loc:T 'overlays.taskSwitcher.overflow', AsTemplate=True}}"
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBodyLarge}"/>
            </Border>
            <TextBlock x:Name="HintText" Grid.Column="1" Text="{loc:T 'overlays.taskSwitcher.hint'}"
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBodyLarge}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
        </Grid>
        <!-- F-CORNER: the close disc — the owner's "Put the close button in the upper right
             corner." Its centre sits at (screen width − 53, 53) DIP, the backdrop hide ✕'s own
             corner (UIConstants.BackdropHideButtonOffset, chosen by the owner on 13.10), so the
             app's two corner exits match. The margin that places it is computed in the code-behind
             from that constant (CloseCornerInset = 53 − 50 = 3 DIP), never restated as a literal;
             right/top alignment then makes the centre follow every screen width and DPI.

             The disc itself is unchanged from F-CLOSE: the shared DwellArcButton at this host's
             centre — bold ActionIcon.Close at Solo, the 2 DIP rim with its dark 3 DIP halo, and the
             rim-arc progress driven from CloseDwellProgress/CloseDwellPaused. The host is 2 × the
             shared r50 hit radius (B8: what is drawn IS what the detector hit-tests); its Canvas
             exists so the halo is not clipped. The halo's painted edge is +2.5 DIP past the disc
             (WPF insets the stroke); the layout keeps a conservative 4 DIP band clear
             (TaskSwitcherLayout.CloseHaloDip), and the 53 DIP offset keeps +52.5 DIP of it on
             screen at both 100 % and 200 %. -->
        <Border x:Name="CloseButton" Grid.Row="0" Width="100" Height="100"
                HorizontalAlignment="Right" VerticalAlignment="Top">
            <Canvas x:Name="CloseLayer" ClipToBounds="False"/>
        </Border>
    </Grid>
</overlays:OverlayWindow>
