<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.DriftNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="DriftNotice_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="560" Height="72">
    <Grid>
        <Border x:Name="Banner"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                CornerRadius="{StaticResource StandardCornerRadius}" Padding="18,10" Opacity="0">
            <TextBlock x:Name="Message"
                       AutomationProperties.AutomationId="DriftNotice_Message"
                       Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeSubtitle}" TextAlignment="Center"
                       Text="Tracking may have drifted — consider re-calibrating"/>
        </Border>
    </Grid>
</overlays:OverlayWindow>
