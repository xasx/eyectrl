<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EyeCtrl.Supervisor\EyeCtrl.Supervisor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked, not copied: the hook is one rule, and a second copy is a second rule. Every
         Core-referencing test project installs both; see AssemblyInfo.cs in this project and
         StringTableIsolationTests in EyeCtrl.App.Tests. -->
    <Compile Include="..\TestSupport\StringTableRestoreAttribute.cs"
             Link="TestSupport\StringTableRestoreAttribute.cs" />
    <Compile Include="..\TestSupport\StringTableObserverAttribute.cs"
             Link="TestSupport\StringTableObserverAttribute.cs" />
  </ItemGroup>
</Project>
