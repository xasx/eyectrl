<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="Keyboard_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <!-- Fixup F3 (owner decision): the note-targeting state is a FRAME, not a label. The border
         is ALWAYS present with a CONSTANT thickness and a transparent brush, so SizeToContent
         never sees a difference; only the brush flips to the accent while IsTargetingNote. -->
    <Border x:Name="KeyboardChrome" Background="{StaticResource BrushSurfaceDark}" CornerRadius="{StaticResource StandardCornerRadius}" Padding="8"
            BorderBrush="Transparent" BorderThickness="3">
        <DockPanel x:Name="RootDock">
            <!-- Prediction bar at top: always one slot per suggestion in text mode, so the bar
                 never changes the window's size. -->
            <UniformGrid x:Name="PredictionBar" Rows="1" HorizontalAlignment="Left"
                        DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <!-- Emoji category tabs (hidden in text mode) -->
            <StackPanel x:Name="CategoryBar" Orientation="Horizontal"
                        DockPanel.Dock="Top" Margin="0,0,0,6"
                        HorizontalAlignment="Center" Visibility="Collapsed"/>
            <!-- Keyboard rows / emoji grid -->
            <StackPanel x:Name="KeyRows" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
</overlays:OverlayWindow>
