<!-- NoResize, like every overlay: pagination chunks against the ctor-time Height; a resize would stale page boundaries. -->
<overlays:OverlayWindow x:Class="EyeCtrl.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="Settings_Window"
        Title="EyeCtrl Settings"
        WindowStyle="None" AllowsTransparency="True"
        Background="{StaticResource BrushSurfaceDark}"
        Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <!-- Sidebar column is 240, not 220: at the live type ramp the widest tab label
         ("Quick Actions") measures a right edge of 233.86 DIP, which spilled onto the content
         column at 220. Guarded by SettingsTabLabelFitTests, which re-measures every label
         against the width parsed out of this very attribute.

         The sidebar is ABSOLUTE, so every DIP it takes comes off the content column. This grid
         and the two margins below are therefore the whole of the content area's width
         arithmetic, and SettingsWindow.ContentAvailableWidth reads all three off these very
         elements rather than restating them — see SettingsContentFitTests, which re-derives the
         same three numbers from this file and measures a picker button against them. -->
    <Grid x:Name="RootGrid" ColumnDefinitions="240, *">

        <!-- Left: Sidebar with tab buttons. Row 2 paginates the tab list: the sidebar is a
             plain non-scrolling stack, and on windows shorter than close-button + 11 tab slots
             the bottom tabs would be clipped out of reach for a gaze user. -->
        <Grid Grid.Column="0" Background="{StaticResource BrushSurfaceMedium}" RowDefinitions="Auto, *, Auto">

            <!-- Close button at top -->
            <Border x:Name="CloseButton" Grid.Row="0"
                    Height="100" Width="100"
                    HorizontalAlignment="Right" Margin="8"
                    CornerRadius="{StaticResource StandardCornerRadius}" Background="{StaticResource BrushAccentDanger}"
                    Cursor="Hand">
                <TextBlock Text="✕" Foreground="{StaticResource BrushSurfaceDark}"
                           FontSize="{StaticResource FontSizeDisplay}" FontWeight="{StaticResource FontWeightStrong}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Current page of tab buttons -->
            <StackPanel x:Name="TabButtonPanel" Grid.Row="1"
                        Margin="8" VerticalAlignment="Top"/>

            <!-- Tab-list pager (hidden while every tab fits one page) -->
            <StackPanel x:Name="TabPagerPanel" Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,8"/>
        </Grid>

        <!-- Right: Content area with pagination.
             This Margin and ContentCard's Padding are the two nested insets
             ContentAvailableWidth subtracts; naming the element is what lets the code read them
             instead of repeating the number. -->
        <Grid x:Name="ContentArea" Grid.Column="1" Margin="16" RowDefinitions="Auto, *, Auto">

            <!-- Page header: which tab this is, and one line on what it covers.
                 Fixed Height so ContentAvailableHeight can subtract it before the first layout
                 pass — the same reason every other budget here reads Height and never
                 ActualHeight. 112, not 96: at the narrowest supported content column the
                 longest tab description wraps to a second line, and a 96 DIP box clips it.
                 SettingsContentFitTests measures the real strings against this very number, and
                 also proves what is left still holds a labelled row.

                 The description is TextSecondary, not TextDim: its backdrop is the PAGE
                 (SurfaceDark), not the card, and it renders at FontSizeSubtitle in normal
                 weight, so it owes the full 4.5:1 rather than the 3.0 large-text allowance.
                 Both pairings are gated per theme by SettingsPageHeaderContrastTests. -->
            <StackPanel x:Name="HeaderPanel" Grid.Row="0" Height="112" Margin="0,0,0,12">
                <TextBlock x:Name="HeaderTitle"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeDisplay}"
                           FontWeight="{StaticResource FontWeightStrong}"/>
                <TextBlock x:Name="HeaderDescription"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Hidden UIA anchor for Settings_Panel_Content — StackPanel is not exposed
                 in the UIA control view; only TextBlock nodes are visible to FlaUI.
                 Row 1, with the card: on row 0 it would land inside the header, and the only
                 suite that reads this anchor is Category=UI, so nothing headless would notice. -->
            <TextBlock AutomationProperties.AutomationId="Settings_Panel_Content"
                       Grid.Row="1" Opacity="0" IsHitTestVisible="False"/>

            <!-- Content page (no ScrollViewer — paginated), on a card.
                 Padding="16,8", NOT 24,8: the horizontal inset has to stay 16 per side, which is
                 exactly what ContentPanel's own Margin="16" used to contribute, or the narrowest
                 supported content column drops below 416 DIP. DwellSlider's stepper row measures
                 404 there and, being a composite, is deliberately NOT capped by
                 ConstrainToContentWidth — its horizontal StackPanel clips rather than wraps — so
                 SettingsContentFitTests.TheSliderRow_FitsTheContentColumn_OnANarrowDisplay is
                 what a wider inset would break, by 4 DIP.
                 ContentPanel carries no Margin of its own any more; this Padding replaced it. -->
            <Grid Grid.Row="1" VerticalAlignment="Top">
                <Border x:Name="ContentCard"
                        CornerRadius="{StaticResource LargeCornerRadius}"
                        Background="{StaticResource BrushSurfaceMedium}"
                        Padding="16,8">
                    <StackPanel x:Name="ContentPanel"/>
                </Border>

                <!-- The card's boundary, drawn as a zero-layout SIBLING of the card rather than as
                     ContentCard's own BorderThickness. That is a LAYOUT decision, not a stylistic
                     one, and it must not be "tidied" onto the card.

                     A Border deflates its child by its BorderThickness, so an outline written on
                     ContentCard would take BorderThicknessStandard per side off the content column
                     (2 DIP in Midnight/Ember, 4 in Contrast) while ContentAvailableWidth — which
                     reads only the Padding — kept reporting the full 416 on the narrowest
                     supported display. That is exactly the nested-inset drift
                     SettingsContentFitTests exists to prevent, and it would over-cap the 460 DIP
                     quick-action picker button by the same amount. IsHitTestVisible="False" in a
                     wrapping Grid consumes no layout at all, so nothing has to be compensated
                     for. Same construction, and the same reasons, as DwellToggle's _cardOutline.

                     StandardBorderThickness, not BorderThicknessStandard: the latter key is the
                     raw double for code and the validator, and WPF cannot convert a double
                     resource to a Thickness (it throws at parse time). StandardBorderThickness is
                     UniformThickness over that same token — the form every other overlay's
                     BorderThickness uses.

                     There has to BE a boundary, on the border rather than the fill: palette rule 1
                     — "the border carries the boundary; the fill only suggests depth",
                     docs/design/overlay-unification-spec.md:284-286, gated by
                     tools/palette_validate.py:352-365 — and the numbers agree. SurfaceMedium on
                     the page's SurfaceDark is a 1.23:1 step, i.e. no visible edge at all, while
                     BorderSubtle on it clears 3:1 in every theme. Gated by
                     SettingsContentCardBoundaryTests. -->
                <Border x:Name="ContentCardOutline"
                        CornerRadius="{StaticResource LargeCornerRadius}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        IsHitTestVisible="False"/>
            </Grid>

            <!-- Pagination bar -->
            <StackPanel x:Name="PaginationPanel" Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,16"/>
        </Grid>

        <!-- Modal overlay (hidden by default) -->
        <Grid x:Name="ModalOverlay" Grid.ColumnSpan="2"
              Visibility="Collapsed">
            <Border Background="{StaticResource BrushModalBackdrop}"/>
            <Border x:Name="ModalContent"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource LargeCornerRadius}"
                    Background="{StaticResource BrushSurfaceLight}"
                    Padding="40,30"
                    MinWidth="400">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="ModalMessage"
                               Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="{StaticResource FontWeightMedium}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>
                    <StackPanel x:Name="ModalButtonPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</overlays:OverlayWindow>
