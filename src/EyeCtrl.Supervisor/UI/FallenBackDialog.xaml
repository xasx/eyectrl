<Window x:Class="EyeCtrl.Supervisor.UI.FallenBackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeCtrl Supervisor"
        Width="640"
        MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E1E">
    <!-- Class-C growth (T09): 640 wide and NoResize, but the HEIGHT follows the content, with
         today's 320 as the minimum. A longer title or body therefore makes the window taller
         instead of squeezing the star row, so the two 110 DIP buttons keep their full height.
         CenterScreen centres the window after its size is known. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText"
                   Grid.Row="0"
                   Foreground="#F4D03F"
                   FontSize="30"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <TextBlock x:Name="BodyText"
                   Grid.Row="1"
                   Foreground="White"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16" />

        <!-- DwellButtons are added from code-behind; they can't be declared in XAML
             because their constructor requires an IDwellRegistrar. -->
        <StackPanel x:Name="ButtonHost"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
    </Grid>
</Window>
