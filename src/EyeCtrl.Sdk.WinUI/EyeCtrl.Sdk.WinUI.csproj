<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EyeCtrl.Sdk.WinUI</PackageId>
    <Description>EyeCtrl gaze-dwell integration for WinUI 3. Attach eyectrl:Dwell.Enabled="True" to any FrameworkElement.</Description>
  </PropertyGroup>
  <!-- WindowsAppSDK needs the AppxPackage MSBuild tools (PRI generation); these ship with Visual
       Studio, not the .NET SDK. Probe the common stable VS 2022 editions, then fall back to a VS 18
       Insiders layout. Override explicitly with -p:AppxMSBuildToolsPath=... for any other install. -->
  <PropertyGroup Condition="'$(AppxMSBuildToolsPath)' == ''">
    <_VsAppxTail>MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</_VsAppxTail>
    <AppxMSBuildToolsPath>$(ProgramFiles)\Microsoft Visual Studio\18\Insiders\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(_VsAppxTail)')">$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(_VsAppxTail)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(_VsAppxTail)')">$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(_VsAppxTail)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(_VsAppxTail)')">$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(_VsAppxTail)</AppxMSBuildToolsPath>
    <AppxMSBuildToolsPath Condition="Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\$(_VsAppxTail)')">$(ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\$(_VsAppxTail)</AppxMSBuildToolsPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <ProjectReference Include="..\EyeCtrl.Sdk.Abstractions\EyeCtrl.Sdk.Abstractions.csproj" />
  </ItemGroup>
</Project>
