<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.ManualSelectionGazeIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="ManualSelectionGazeIndicator_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="30" Height="30">
    <Canvas>
        <!-- Outer shrinking circle -->
        <Ellipse x:Name="OuterCircleHalo"
                 Stroke="{StaticResource BrushStrokeHalo}" StrokeThickness="4"
                 Fill="Transparent"
                 Width="30" Height="30"
                 Canvas.Left="0" Canvas.Top="0"/>
        <Ellipse x:Name="OuterCircle"
                 Stroke="{StaticResource BrushAccent}" StrokeThickness="2" Fill="Transparent"
                 Width="30" Height="30"
                 Canvas.Left="0" Canvas.Top="0"/>
        <!-- Center dot (fixed size) -->
        <Ellipse x:Name="CenterDot"
                 Fill="{StaticResource BrushAccent}"
                 Stroke="{StaticResource BrushStrokeHalo}"
                 StrokeThickness="2"
                 Width="10" Height="10"
                 Canvas.Left="10" Canvas.Top="10"/>
        <!-- UIA anchor -->
        <TextBlock AutomationProperties.AutomationId="ManualSelectionGazeIndicator_Ellipse_Main"
                   Opacity="0" IsHitTestVisible="False"
                   Canvas.Left="0" Canvas.Top="0"/>
    </Canvas>
</overlays:OverlayWindow>
