<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      C9 S6a: the install engine. It starts at medium IL (asInvoker) and re-launches only its
      internal elevated sub-verbs with ShellExecute runas. The manifest is explicit rather than
      the SDK default so the asInvoker/uiAccess="false" pair is pinned by test.

      Self-contained is a publish concern (S6b's Publish-Signed.ps1 passes
      self-contained true and a win-x64 runtime), matching EyeCtrl.App: the uninstall path must
      still work after a .NET runtime has been removed from the machine.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>EyeCtrl.Setup.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EyeCtrl.Core\EyeCtrl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EyeCtrl.Setup.Tests" />
  </ItemGroup>

</Project>
