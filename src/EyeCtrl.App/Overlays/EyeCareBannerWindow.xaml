<local:OverlayWindow x:Class="EyeCtrl.App.Overlays.EyeCareBannerWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:EyeCtrl.App.Overlays"
                     WindowStyle="None" AllowsTransparency="True"
                     Topmost="True" ShowInTaskbar="False"
                     Background="Transparent"
                     Width="{x:Static SystemParameters.PrimaryScreenWidth}"
                     Height="120"
                     Left="0" Top="0">

    <Grid>
        <!-- Dim the work area below the banner (click-through) -->
        <Rectangle x:Name="WorkDim" Fill="{StaticResource BrushModalBackdrop}" Visibility="Collapsed"/>

        <!-- Top banner strip -->
        <Border VerticalAlignment="Top" Height="80" Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="MessageText" Text="👁 Time for an eye break"
                               Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="{StaticResource FontWeightMedium}"/>
                    <TextBlock x:Name="SubText" Text="You've been fixating for a while"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBody}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Two large dwell circles: Start (accept) and Snooze. The ✕/▶ glyph sizes
                         are set in the constructor as a ratio of the 64px ring — XAML cannot
                         express the multiplication. -->
                    <Grid Margin="0,0,16,0" Width="64" Height="64">
                        <Ellipse x:Name="SnoozeRing" Stroke="{StaticResource BrushTextDim}" StrokeThickness="2" StrokeDashArray="3 3"/>
                        <TextBlock x:Name="SnoozeGlyph" Text="✕" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="snooze" Foreground="{StaticResource BrushTextDim}" FontSize="{StaticResource FontSizeBody}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-16"/>
                    </Grid>
                    <Grid Width="64" Height="64">
                        <Ellipse x:Name="StartRing" Stroke="{StaticResource BrushAccent}" StrokeThickness="2" StrokeDashArray="3 3"/>
                        <TextBlock x:Name="StartGlyph" Text="▶" Foreground="{StaticResource BrushAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="start" Foreground="{StaticResource BrushAccent}" FontSize="{StaticResource FontSizeBody}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-16"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:OverlayWindow>
