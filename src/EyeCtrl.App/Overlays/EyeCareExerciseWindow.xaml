<local:OverlayWindow x:Class="EyeCtrl.App.Overlays.EyeCareExerciseWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:EyeCtrl.App.Overlays"
                     WindowStyle="None" AllowsTransparency="True"
                     Topmost="True" ShowInTaskbar="False"
                     Background="#E8000000"
                     Width="{x:Static SystemParameters.PrimaryScreenWidth}"
                     Height="{x:Static SystemParameters.PrimaryScreenHeight}"
                     Left="0" Top="0">

    <Grid>
        <Canvas x:Name="Stage">
            <!-- Target dot -->
            <Ellipse x:Name="TargetDot" Width="36" Height="36" Fill="#FF6c8cff" Opacity="0.9"/>
            <!-- Live gaze cursor (green ring) -->
            <Ellipse x:Name="GazeRing" Width="44" Height="44" Stroke="#FF7ee787" StrokeThickness="2"/>
        </Canvas>

        <!-- HUD (top center): name + countdown, no score -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock x:Name="ExerciseName" Foreground="White" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="Countdown" Foreground="#FFAAAAAA" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Skip button (corner) -->
        <Button x:Name="SkipButton" Content="Skip ✕" Width="60" Height="32"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                Foreground="#FF888888" Background="Transparent" BorderBrush="#FF444444"/>

        <!-- Progress bar -->
        <ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Bottom" Minimum="0" Maximum="100"/>

        <!-- Summary card (hidden until exercise ends) -->
        <Border x:Name="SummaryCard" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F0181830" BorderBrush="#FF6c8cff" BorderThickness="1" CornerRadius="14"
                Padding="28,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="SummaryTitle" Text="✓ Nice work" Foreground="#FF7ee787" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="SummaryName" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="SummaryAccuracy" Foreground="#FF6c8cff" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="accuracy" Foreground="#FF888888" FontSize="9" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="SummarySteadiness" Foreground="#FF6c8cff" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="steadiness" Foreground="#FF888888" FontSize="9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SummaryEncourage" Foreground="#FF888888" FontSize="9" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</local:OverlayWindow>
