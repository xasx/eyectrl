<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.ActivationButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="160" Height="160">
    <Canvas>
        <!-- The fixation halo: two symmetric, concentric full circles centred on the pin. Halo first
             (spec §4.1.3): later siblings paint on top, so the wider band must come first.
             There is deliberately NO arc head and no offset placement — the progress scalar moves
             the radius of both circles, so the feedback never draws a mark away from the point the
             dwell is counted at. ShowAt resizes the window around the max radius before it is
             shown, so these design-time dimensions are only what the designer sees. -->
        <Ellipse x:Name="ProgressHalo"
                 Stroke="{StaticResource BrushStrokeHalo}" StrokeThickness="7"
                 Canvas.Left="0" Canvas.Top="0"/>
        <Ellipse x:Name="ProgressRing"
                 Stroke="{StaticResource BrushAccent}" StrokeThickness="5"
                 Canvas.Left="0" Canvas.Top="0"/>
    </Canvas>
</overlays:OverlayWindow>
