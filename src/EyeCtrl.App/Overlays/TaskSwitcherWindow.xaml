<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.TaskSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
        xmlns:ctl="clr-namespace:EyeCtrl.Controls;assembly=EyeCtrl.Controls"
        AutomationProperties.AutomationId="TaskSwitcher_Window"
        Title="{loc:T 'overlays.toolbar.taskSwitcher'}"
        WindowStyle="None" AllowsTransparency="True" Background="{StaticResource BrushSurfaceDark}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        IsClickThrough="False">
    <overlays:OverlayWindow.Resources>
        <!-- The three new states are boolean VM flags; WPF has no implicit bool-to-Visibility
             conversion, and a window-local converter keeps them declarative (the codebase's other
             state cues are single-property writes, so no style/trigger machinery is needed). -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </overlays:OverlayWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" x:Name="TilesScroll" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl x:Name="TilesPanel" AutomationProperties.AutomationId="TaskSwitcher_Tiles" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="200" ItemHeight="120"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" Background="{StaticResource BrushSurfaceMedium}" CornerRadius="{StaticResource StandardCornerRadius}" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBody}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               MaxWidth="180"/>
                                    <!-- S2-B: a minimised window looks like any other tile, but selecting it
                                         RESTORES it — the screen the owner is looking at moves. The badge says
                                         so. INSIDE the tile face, and never a target of its own: the face is
                                         the dwell target, and a badge that widened the perceived tile would put
                                         a hit area where nothing is drawn. It must NOT dim the tile —
                                         DwellPausedOpacityConverter owns that cue. HorizontalAlignment=Center
                                         is what makes it a BADGE: without it the Border stretches to the
                                         content column and a long, trimmed title turns it into a light band
                                         across the tile (~167 DIP instead of ~82). -->
                                    <Border x:Name="MinimizedBadge" Margin="0,3,0,0" Padding="6,1"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource BrushSurfaceLight}"
                                            CornerRadius="{StaticResource SmallCornerRadius}"
                                            Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- The mark is DRAWN, not typeset: a low bar is the minimise
                                                 shape, no font in the standard face provides one (U+2581
                                                 falls back to a hairline), and the emoji-presentation
                                                 U+1F5D5 is what Emoji.Wpf substitutes — the drawn arrow in
                                                 the emoji grid's back key is the same deliberate choice. -->
                                            <Border x:Name="MinimizedGlyph" Width="10" Height="2"
                                                    Background="{StaticResource BrushTextSecondary}"
                                                    VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{loc:T 'overlays.taskSwitcher.minimized'}"
                                                       Foreground="{StaticResource BrushTextSecondary}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- Dwell progress: without it a tile gives NO feedback while a
                                     700ms dwell builds, which reads as "not dwellable" (2026-08-17
                                     field report) — every other dwell surface in the app shows this. -->
                                <ProgressBar Grid.Row="1" Value="{Binding DwellProgress}" Maximum="1" Minimum="0"
                                             Height="6" Margin="0,6,0,0"
                                             Foreground="{StaticResource BrushAccent}" Background="Transparent"
                                             BorderThickness="0" Focusable="False" IsHitTestVisible="False"
                                             Opacity="{Binding IsDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- S2-B: no window to offer (more likely since S2-A leaves the foreground window out).
             Centred where the tile block would be — the Margin mirrors the tile viewport's, so it
             follows the docked toolbar keep-out without a second geometry source. No dwell target:
             nothing here is registered, and the ✕ below stays the escape. -->
        <TextBlock x:Name="EmptyMessage" Grid.Row="0"
                   Text="{loc:T 'overlays.taskSwitcher.empty'}"
                   Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBodyLarge}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   Margin="{Binding Margin, ElementName=TilesScroll}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
        <Grid Grid.Row="1" x:Name="HintRow">
            <!-- Hint and close disc share ONE centred row (review m4): the ✕ sits directly
                 beside the text that names it, at horizontal screen centre where tracking is
                 most accurate — the previous bottom-right corner placement put the only
                 non-switching escape in the corner band, where tracker accuracy is weakest
                 and a mis-aimed dwell could land on the last tile column and switch a window.
                 The 48 DIP gap keeps dwell built while reading the hint's trailing words off
                 the disc's drawn edge (B8: the hit circle IS the drawn disc).

                 S2-B fixup-01: the row is THREE columns — the chip lives in the left STAR column,
                 the hint + ✕ in the middle Auto column — so showing the chip cannot move the pair.
                 The ✕ is the escape and a gaze-only user finds it by where it was last time; a
                 widened centred group would shift it 84 DIP right whenever the count appeared. The
                 two star columns are equal, which centres the Auto column exactly as the single
                 centred StackPanel was centred before. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- S2-B overflow chip: windows enumerated beyond the grid's capacity have no tile, so
                 the row says how many. It sits in the LEFT star column, right-aligned 32 DIP from
                 that column's end — i.e. 32 DIP left of the hint's left edge — so it is outside the
                 ✕'s hit circle by construction (32 DIP its margin + the hint's width + the 48 DIP
                 hint→✕ gap), which is what keeps a gaze resting on the chip from filling the ✕. It
                 never changes a column's size: the star column absorbs it. Not a dwell target. -->
            <Border x:Name="OverflowChip" Grid.Column="0" HorizontalAlignment="Right"
                    Margin="0,12,32,12" Padding="12,4"
                    VerticalAlignment="Center" IsHitTestVisible="False"
                    Background="{StaticResource BrushSurfaceLight}"
                    CornerRadius="{StaticResource StandardCornerRadius}"
                    Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OverflowCount, StringFormat={loc:T 'overlays.taskSwitcher.overflow'}}"
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBodyLarge}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="HintText" Text="{loc:T 'overlays.taskSwitcher.hint'}"
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBodyLarge}"
                           VerticalAlignment="Center" Margin="0,12"/>
                <!-- Close button — a gaze dwell target (registered + positioned in code-behind),
                     mirroring QuickActionsGridWindow's proven close disc: NOT a WPF Button (gaze
                     produces no mouse clicks, and there is no DwellButtonStyle resource in this
                     app). Dwell progress binds to CloseDwellProgress. The disc is 2 × the shared
                     r50 hit radius (B8), so what is drawn IS what the detector hit-tests; keep
                     Width == Height == TaskSwitcherWindow.CloseButtonSize. -->
                <Border x:Name="CloseButton" Width="100" Height="100" Margin="48,12,0,12"
                        CornerRadius="{StaticResource CircleCornerRadius}" Background="{StaticResource BrushSurfaceMedium}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}">
                    <Grid>
                        <!-- FontSize is set in the constructor from CloseButtonSize × the container
                             ratio — XAML cannot express the multiplication. The glyph TextBlock
                             carries the UIA name (D11): the Border around it has no automation
                             peer, so an explicit name on the glyph is what a screen reader
                             announces instead of "✕". -->
                        <TextBlock x:Name="CloseGlyph" Text="&#x2715;" Foreground="{StaticResource BrushTextPrimary}"
                                   AutomationProperties.Name="{loc:T 'overlays.edge.close'}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding CloseDwellProgress}"
                                     Height="4" VerticalAlignment="Bottom"
                                     Background="Transparent" Foreground="{StaticResource BrushAccent}"
                                     BorderThickness="0" Focusable="False" IsHitTestVisible="False"
                                     Opacity="{Binding CloseDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</overlays:OverlayWindow>
