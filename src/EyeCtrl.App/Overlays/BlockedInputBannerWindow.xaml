<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.BlockedInputBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
        AutomationProperties.AutomationId="BlockedInputBanner_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="{x:Static SystemParameters.PrimaryScreenWidth}" Height="304"
        Left="0" Top="0">

    <Grid>
        <!-- The message strip. It must be readable before anything else in the block: the owner
             cannot click, so the sentence has to say what is wrong without any interaction. -->
        <Border VerticalAlignment="Top" Height="96" Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="MessageText"
                               AutomationProperties.AutomationId="BlockedInputBanner_Message"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="{StaticResource FontWeightMedium}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailText"
                               AutomationProperties.AutomationId="BlockedInputBanner_Detail"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Two gaze-only exits, wide enough for their German labels and placed below the message
             strip. Their whole rectangles are the hit areas (the RestartNotice pattern): a shape
             that big is unambiguous for a user whose cursor is frozen. The panel's top margin and
             the window height are set in code from the live toolbar dock. -->
        <StackPanel x:Name="ButtonLayer" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,160,20,0">
            <Border x:Name="EscapeButton"
                    AutomationProperties.AutomationId="BlockedInputBanner_Escape"
                    Width="340" Height="100" Margin="0,0,24,0"
                    Background="{StaticResource BrushSurfaceKeySwitch}"
                    CornerRadius="{StaticResource StandardCornerRadius}">
                <TextBlock x:Name="EscapeLabel" Text="{loc:T 'overlays.blocked.escape'}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeTitle}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
            </Border>
            <Border x:Name="DismissButton"
                    AutomationProperties.AutomationId="BlockedInputBanner_Dismiss"
                    Width="200" Height="100"
                    Background="{StaticResource BrushSurfaceKeySwitch}"
                    CornerRadius="{StaticResource StandardCornerRadius}">
                <TextBlock x:Name="DismissLabel" Text="{loc:T 'overlays.blocked.dismiss'}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeTitle}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
            </Border>
        </StackPanel>
    </Grid>
</overlays:OverlayWindow>
