<Window x:Class="EyeCtrl.App.Overlays.ActivationButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="60" Height="60">
    <Canvas>
        <!-- Background circle -->
        <Ellipse x:Name="BackgroundCircle"
                 Fill="#80000000"
                 Width="60" Height="60"
                 Canvas.Left="0" Canvas.Top="0"/>
        <!-- Dwell progress arc -->
        <Path x:Name="ProgressArc" Stroke="Lime" StrokeThickness="4" Canvas.Left="0" Canvas.Top="0">
            <Path.Data>
                <PathGeometry>
                    <PathFigure x:Name="ArcFigure" StartPoint="30,4" IsClosed="False">
                        <ArcSegment x:Name="ArcSegment"
                                    Point="30,4"
                                    Size="26,26"
                                    IsLargeArc="False"
                                    SweepDirection="Clockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
        <!-- Center icon -->
        <Ellipse Fill="White" Width="20" Height="20"
                 Canvas.Left="20" Canvas.Top="20"/>
    </Canvas>
</Window>
