<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EyeCtrl.Core\EyeCtrl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The synthetic gaze streams the replay analyzer validates against, shared with the benchmark
      suite as a LINK rather than a copy: two drifting definitions of "a fixation stream" would make
      analyzer results and benchmark results quietly incomparable. Linked rather than referenced
      because EyeCtrl.Benchmarks carries BenchmarkDotNet, which has no business in a test project
      (and quality metrics were an explicit non-goal for that suite).
    -->
    <Compile Include="..\..\benchmarks\EyeCtrl.Benchmarks\GazeStreamGenerator.cs"
             Link="Analysis\GazeStreamGenerator.cs" />
    <!--
      Linked, not copied: the hook is one rule, and a second copy is a second rule. See the
      attribute's summary and tests/EyeCtrl.Core.Tests/AssemblyInfo.cs.
    -->
    <Compile Include="..\TestSupport\DpiHelperRestoreAttribute.cs"
             Link="TestSupport\DpiHelperRestoreAttribute.cs" />
    <Compile Include="..\TestSupport\DpiHelperScaleObserverAttribute.cs"
             Link="TestSupport\DpiHelperScaleObserverAttribute.cs" />
    <!-- Same shared-rule link for the string-table restore hook and its observer. -->
    <Compile Include="..\TestSupport\StringTableRestoreAttribute.cs"
             Link="TestSupport\StringTableRestoreAttribute.cs" />
    <Compile Include="..\TestSupport\StringTableObserverAttribute.cs"
             Link="TestSupport\StringTableObserverAttribute.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The committed replay fixture for the fixation gates. A loose file next to the test binary, like
      every other data file in this repo, so the committed bytes are exactly what the tests measured.
    -->
    <None Update="Analysis\Fixtures\fixation-gates-synthetic.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
