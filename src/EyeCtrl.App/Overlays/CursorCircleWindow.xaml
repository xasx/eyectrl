<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.CursorCircleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="CursorCircle_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="250" Height="250">
    <Canvas>
        <!-- Two bands, outer then core: later siblings paint on top, so the wider one must
             come first. Which band is dark depends on CursorSettings.RingStyle — under
             AchromaticReticle "CircleHalo" carries TextPrimary, not StrokeHalo. The names are
             historical; CursorRingStacks decides the colours (spec §4.1.3, §10). -->
        <Ellipse x:Name="CircleHalo"
                 Stroke="{StaticResource BrushStrokeHalo}" StrokeThickness="4"
                 Width="250" Height="250"
                 Canvas.Left="0" Canvas.Top="0"/>
        <Ellipse x:Name="Circle"
                 Stroke="{StaticResource BrushAccent}" StrokeThickness="2"
                 Width="250" Height="250"
                 Canvas.Left="0" Canvas.Top="0"/>
        <!-- Wave C C1: the "fired" flash, a weight step. Collapsed at rest; FiredFlash shows both
             for one brief step. They are the two bands again (same colours and opacities, set in
             UpdateAppearance), only wider, outer then core like the rest pair, so the ring turns
             bolder in both polarities. Declared after the rest bands so they paint over them;
             the rest bands themselves are never written by the flash. -->
        <Ellipse x:Name="FiredFlashOuter" Visibility="Collapsed" IsHitTestVisible="False"
                 Width="250" Height="250"
                 Canvas.Left="0" Canvas.Top="0"/>
        <Ellipse x:Name="FiredFlashCore" Visibility="Collapsed" IsHitTestVisible="False"
                 Width="250" Height="250"
                 Canvas.Left="0" Canvas.Top="0"/>
        <!-- Hidden TextBlock as UIA anchor — WPF transparent overlay windows only expose
             TextBlock (ControlType.Text) nodes in the UIA tree; Ellipse/Canvas are collapsed. -->
        <TextBlock AutomationProperties.AutomationId="CursorCircle_Ellipse_Main"
                   Opacity="0" IsHitTestVisible="False"
                   Canvas.Left="0" Canvas.Top="0"/>
    </Canvas>
</overlays:OverlayWindow>
