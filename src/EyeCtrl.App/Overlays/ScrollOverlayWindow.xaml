<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.ScrollOverlayWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
                        Title="Scroll Overlay"
                        Topmost="True"
                        ShowInTaskbar="False"
                        WindowStyle="None"
                        AllowsTransparency="True"
                        Background="Transparent"
                        IsHitTestVisible="False">
    <Grid>
        <!-- Canvas positions everything else in absolute (window-relative) coordinates set from
             code-behind; the Grid wrapper exists only so the escape hint below can use ordinary
             corner alignment, which a bare Canvas ignores. -->
        <Canvas x:Name="OverlayCanvas">
            <Line x:Name="AnchorCrosshairH" Stroke="{StaticResource BrushTextPrimary}" StrokeThickness="1" Opacity="0.5"/>
            <Line x:Name="AnchorCrosshairV" Stroke="{StaticResource BrushTextPrimary}" StrokeThickness="1" Opacity="0.5"/>

            <Ellipse x:Name="CursorCircle" Stroke="{StaticResource BrushTextPrimary}" StrokeThickness="2"
                     Width="80" Height="80" Opacity="0.7"/>
            <Ellipse x:Name="AnchorDot" Fill="{StaticResource BrushTextPrimary}" Width="8" Height="8" Opacity="0.9"/>
            <!-- Halo stays at Opacity=1 so the §4.1.3 edge holds; only the accent ring dims. -->
            <Ellipse x:Name="VelocityRingHalo" Stroke="{StaticResource BrushStrokeHalo}"
                     StrokeThickness="4" Width="80" Height="80"/>
            <Ellipse x:Name="VelocityRing" Stroke="{StaticResource BrushAccent}"
                     StrokeThickness="2" Width="80" Height="80" Opacity="0.8"/>
        </Canvas>

        <!-- Escape hint: mirrors CalibrationWindow's CancelHint (placement, wording, styling).
             Unconditional — this window exists only while scroll mode is active, unlike the
             backdrop's hint, which toggles within a longer-lived window. -->
        <TextBlock x:Name="EscapeHint" Foreground="{StaticResource BrushTextDim}" FontSize="{StaticResource FontSizeBody}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,20,20"
                   Text="Press Esc to stop scrolling"/>
    </Grid>
</overlays:OverlayWindow>
