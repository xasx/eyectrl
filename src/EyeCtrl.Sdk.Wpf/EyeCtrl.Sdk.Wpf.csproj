<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0-windows ON PURPOSE (rest of the solution is net10.0): this assembly ships to external
         SDK consumers, and targeting the oldest supported LTS maximizes the apps that can
         reference it. Do NOT "upgrade" this to match the solution TFM until .NET 8 LTS
         end-of-life (Nov 2026), or sooner if the SDK-consumer-reach policy changes. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EyeCtrl.Sdk.Wpf</PackageId>
    <Description>EyeCtrl gaze-dwell integration for WPF. Attach eyectrl:Dwell.Enabled="True" to any FrameworkElement.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EyeCtrl.Sdk.Abstractions\EyeCtrl.Sdk.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EyeCtrl.Sdk.Wpf.Tests" />
  </ItemGroup>
</Project>
