<!-- Height 116, not 110: the 12px type-ramp floor needs 95.88px of content space and
     Padding="8" leaves only 94 at 110 (design spec §8.6). This is the one scoped
     layout exception in that work; TrackStatusFitTests couples it to the arithmetic. -->
<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.TrackStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" IsClickThrough="True" ResizeMode="NoResize"
        Width="160" Height="116">
    <Border Background="{StaticResource BrushSurfaceDark}" CornerRadius="{StaticResource StandardCornerRadius}" Padding="8">
        <StackPanel>
            <TextBlock Text="Track Status" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBody}" FontWeight="{StaticResource FontWeightStrong}" Margin="0,0,0,4"/>
            <!-- Track box with eye dots -->
            <Canvas Width="60" Height="40" HorizontalAlignment="Left" Margin="0,0,8,0">
                <Border Width="60" Height="40" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}" Background="{StaticResource BrushSurfaceMedium}"/>
                <Ellipse x:Name="LeftEyeDot" Width="6" Height="6" Fill="{StaticResource BrushAccentSuccess}"/>
                <Ellipse x:Name="RightEyeDot" Width="6" Height="6" Fill="{StaticResource BrushAccentSuccess}"/>
            </Canvas>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Distance: " Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBody}"/>
                <TextBlock x:Name="DistanceText" Text="—" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBody}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quality: " Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBody}"/>
                <TextBlock x:Name="QualityText" Text="Unknown" Foreground="{StaticResource BrushAccentWarning}" FontSize="{StaticResource FontSizeBody}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</overlays:OverlayWindow>
