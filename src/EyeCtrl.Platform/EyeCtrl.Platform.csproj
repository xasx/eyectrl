<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EyeCtrl.Core\EyeCtrl.Core.csproj" />
  </ItemGroup>

  <!-- Tobii Stream Engine: only on Windows where the SDK is installed -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('C:\Program Files\Tobii\Tobii EyeX\Tobii.StreamEngine.Net.dll')">
    <Reference Include="Tobii.StreamEngine.Net">
      <HintPath>C:\Program Files\Tobii\Tobii EyeX\Tobii.StreamEngine.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="C:\Program Files\Tobii\Tobii EyeX\tobii_stream_engine.dll"
             Condition="Exists('C:\Program Files\Tobii\Tobii EyeX\tobii_stream_engine.dll')">
      <Link>tobii_stream_engine.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('C:\Program Files\Tobii\Tobii EyeX\Tobii.StreamEngine.Net.dll')">
    <DefineConstants>$(DefineConstants);TOBII_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
