<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EyeCtrl.Core\EyeCtrl.Core.csproj" />
  </ItemGroup>

  <!-- Tobii Stream Engine: shared probe defines TobiiSdkAvailable + TOBII_AVAILABLE. -->
  <Import Project="..\Tobii.props" />

  <ItemGroup Condition="'$(TobiiSdkAvailable)' == 'true'">
    <Reference Include="Tobii.StreamEngine.Net">
      <HintPath>$(TobiiManagedDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(TobiiNativeDll)">
      <Link>tobii_stream_engine.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- ProcessIdentity (Win32 P/Invokes) is internal; Supervisor's ClientIdentityBinder consumes it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="EyeCtrl.Supervisor" />
    <InternalsVisibleTo Include="EyeCtrl.Platform.Tests" />
  </ItemGroup>

</Project>
