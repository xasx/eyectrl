<local:OverlayWindow x:Class="EyeCtrl.App.Overlays.EyeCareExerciseWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:EyeCtrl.App.Overlays"
                     WindowStyle="None" AllowsTransparency="True"
                     Topmost="True" ShowInTaskbar="False"
                     Background="{StaticResource BrushSurfaceDark}"
                     Width="{x:Static SystemParameters.PrimaryScreenWidth}"
                     Height="{x:Static SystemParameters.PrimaryScreenHeight}"
                     Left="0" Top="0">

    <Grid>
        <Canvas x:Name="Stage">
            <!-- Target dot -->
            <Ellipse x:Name="TargetDot" Width="36" Height="36" Fill="{StaticResource BrushAccent}" Opacity="0.9"/>
            <!-- Live gaze cursor (green ring) -->
            <Ellipse x:Name="GazeRing" Width="44" Height="44" Stroke="{StaticResource BrushAccentSuccess}" StrokeThickness="2"/>
        </Canvas>

        <!-- HUD (top center): name + countdown, no score -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock x:Name="ExerciseName" Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="Countdown" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Skip button (corner) -->
        <Button x:Name="SkipButton" Content="Skip ✕" Width="60" Height="32"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20"
                Foreground="{StaticResource BrushTextDim}" Background="Transparent" BorderBrush="{StaticResource BrushBorderSubtle}"/>

        <!-- Progress bar -->
        <ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Bottom" Minimum="0" Maximum="100"/>

        <!-- Summary card (hidden until exercise ends) -->
        <Border x:Name="SummaryCard" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BrushSurfaceLight}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14"
                Padding="28,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="SummaryTitle" Text="✓ Nice work" Foreground="{StaticResource BrushAccentSuccess}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="SummaryName" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="SummaryAccuracy" Foreground="{StaticResource BrushAccent}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="accuracy" Foreground="{StaticResource BrushTextDim}" FontSize="9" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="SummarySteadiness" Foreground="{StaticResource BrushAccent}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="steadiness" Foreground="{StaticResource BrushTextDim}" FontSize="9" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="ReactionTimePanel" Visibility="Collapsed">
                        <TextBlock x:Name="SummaryReactionTime" Foreground="{StaticResource BrushAccent}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="reaction ms" Foreground="{StaticResource BrushTextDim}" FontSize="9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SummaryEncourage" Foreground="{StaticResource BrushTextDim}" FontSize="9" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</local:OverlayWindow>
