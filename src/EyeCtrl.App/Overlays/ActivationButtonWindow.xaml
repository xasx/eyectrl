<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.ActivationButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="100" Height="100">
    <Canvas>
        <!-- Background circle -->
        <Ellipse x:Name="BackgroundCircle"
                 Fill="#80000000"
                 Width="100" Height="100"
                 Canvas.Left="0" Canvas.Top="0"/>
        <!-- Dwell progress arc -->
        <Path x:Name="ProgressArc" Stroke="Lime" StrokeThickness="5" Canvas.Left="0" Canvas.Top="0">
            <Path.Data>
                <PathGeometry>
                    <PathFigure x:Name="ArcFigure" StartPoint="50,5" IsClosed="False">
                        <ArcSegment x:Name="ArcSegment"
                                    Point="50,5"
                                    Size="45,45"
                                    IsLargeArc="False"
                                    SweepDirection="Clockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>
        <!-- Center icon -->
        <Ellipse Fill="White" Width="30" Height="30"
                 Canvas.Left="35" Canvas.Top="35"/>
    </Canvas>
</overlays:OverlayWindow>
