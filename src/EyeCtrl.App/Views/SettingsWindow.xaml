<Window x:Class="EyeCtrl.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeCtrl Settings" Width="850" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Left: Dwellable tab buttons -->
        <StackPanel x:Name="TabButtonPanel" Grid.Column="0" Grid.Row="0"
                    Margin="8" VerticalAlignment="Top"/>

        <!-- Right: Dynamic content area (rebuilt per tab) -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" Margin="8"
                      VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel x:Name="ContentPanel"/>
        </ScrollViewer>

        <!-- Bottom: Dwellable Save / Cancel buttons -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                    x:Name="ActionButtonPanel" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,8"/>
    </Grid>
</Window>
