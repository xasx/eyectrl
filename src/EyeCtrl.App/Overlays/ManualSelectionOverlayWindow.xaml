<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.ManualSelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    <Grid>
        <!-- F5: an opaque theme panel under the picture. On a failed capture the ImageBrush has no
             source, and without this the disc would be see-through onto the backdrop-dimmed 1x
             screen while dwells still map as magnified. With a picture, the opaque capture covers it
             completely; with none, the user sees a dark disc, not a normal-size screen. -->
        <Ellipse x:Name="DiscBackdrop" Fill="{StaticResource BrushSurfaceDark}"/>
        <Ellipse x:Name="ClipEllipse">
            <Ellipse.Fill>
                <ImageBrush x:Name="ManualSelectionBrush" Stretch="Fill"/>
            </Ellipse.Fill>
        </Ellipse>
        <!-- The magnifier rim sits on the captured image (arbitrary screen content), so it is
             the §4.1.3 case: halo under-stroke first (later siblings paint on top), accent
             rim over it, making the visible feature the backdrop-independent internal edge. -->
        <Ellipse x:Name="RimHalo" Stroke="{StaticResource BrushStrokeHalo}"
                 StrokeThickness="4" IsHitTestVisible="False"/>
        <Ellipse x:Name="Rim" Stroke="{StaticResource BrushTextPrimary}"
                 StrokeThickness="2" IsHitTestVisible="False"/>
        <!-- Wave C C1: the rim's "fired" flash when the magnifier opens from an accepted offer, a
             weight step. Collapsed at rest; the same halo/rim pair in the same brushes and order,
             only wider (widths from FiredFlash.PeakStack, set in code), painted over the rest
             pair, which the flash never writes. -->
        <Ellipse x:Name="RimFlashHalo" Stroke="{StaticResource BrushStrokeHalo}"
                 Visibility="Collapsed" IsHitTestVisible="False"/>
        <Ellipse x:Name="RimFlash" Stroke="{StaticResource BrushTextPrimary}"
                 Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</overlays:OverlayWindow>
