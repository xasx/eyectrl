<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.QuickActionsGridWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
                        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
                        xmlns:ctl="clr-namespace:EyeCtrl.Controls;assembly=EyeCtrl.Controls"
                        xmlns:vm="clr-namespace:EyeCtrl.ViewModels;assembly=EyeCtrl.ViewModels"
                        Width="400" Height="600"
                        WindowStyle="None" AllowsTransparency="True"
                        Background="Transparent" Topmost="True"
                        ShowInTaskbar="False">
    <Grid>
        <Border x:Name="RootBorder" Background="{StaticResource BrushSurfaceDark}" CornerRadius="{StaticResource StandardCornerRadius}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Close button — a gaze dwell target (registered + positioned in code-behind).
                     NOT a WPF Button: gaze produces no mouse clicks, and there is no
                     DwellButtonStyle resource in this app. Dwell progress binds to CloseDwellProgress.
                     The disc is 2 × the shared r50 hit radius (B8), so what is drawn IS what the
                     detector hit-tests; the header row's height keeps it clear of the tile band.
                     Keep width == height == QuickActionsGridWindow.CloseButtonSize. -->
                <Border x:Name="CloseButton" Grid.Row="0"
                        Width="100" Height="100" HorizontalAlignment="Right"
                        CornerRadius="{StaticResource CircleCornerRadius}" Background="{StaticResource BrushSurfaceMedium}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}">
                    <Grid>
                        <!-- FontSize is set in the constructor from CloseButtonSize × the
                             container ratio — XAML cannot express the multiplication.
                             The glyph TextBlock carries the UIA name (D11): the Border around it
                             has no automation peer, so an explicit name on the glyph is what a
                             screen reader announces instead of "✕". -->
                        <TextBlock x:Name="CloseGlyph" Text="&#x2715;" Foreground="{StaticResource BrushTextPrimary}"
                                   AutomationProperties.Name="{loc:T 'overlays.edge.close'}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding CloseDwellProgress}"
                                     Height="4" VerticalAlignment="Bottom"
                                     Background="Transparent" Foreground="{StaticResource BrushAccent}"
                                     BorderThickness="0"
                                     Opacity="{Binding CloseDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                    </Grid>
                </Border>
                <!-- Action tiles. The ItemsSource binding was missing (the control was never
                     populated — tiles were sized into the window but never rendered); B8's gap is
                     measured against these tiles, so the meant layout has to be the real one. -->
                <ItemsControl x:Name="TilesControl" Grid.Row="1" Margin="0,8,0,0"
                              ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Rows omitted (defaults to 0 = auto-compute from Columns + item count).
                                 RowCount raises no PropertyChanged, so binding it would go stale on Reload. -->
                            <UniformGrid Columns="{Binding GridColumns, FallbackValue=3}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickActionTileViewModel}">
                            <!-- B8b F2: drawn = hit. The face is a 100 DIP DISC — exactly the r50
                                 dwell circle the detector hit-tests — centred in a 128 DIP cell, so
                                 two hit circles keep a 28 DIP dead gap (R4 needs ≥ 20). The old
                                 120 DIP square drew a 45 % dead band outside its hit area. The
                                 14 DIP margin is (QuickActionsGridWindow.TileCell - TileSize)/2;
                                 keep Width == Height == QuickActionsGridWindow.TileSize (pinned
                                 by GlyphSizeCouplingTests) or the CircleCornerRadius token renders
                                 an ellipse. -->
                            <Border x:Name="TileBorder" Width="100" Height="100"
                                    CornerRadius="{StaticResource CircleCornerRadius}" Background="{StaticResource BrushSurfaceMedium}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}"
                                    Margin="14">
                                <Grid>
                                    <!-- B8b fixup-01 R1: the dwell feedback is a RIM ARC, not a
                                         bottom bar. A straight bar spanned the label and sat 25–47
                                         DIP below the centre, where the disc is too narrow for it
                                         (it crossed the rim in 13 of 36 presets). The arc traces
                                         the r50 hit circle at r45 ± the 4 DIP stroke, so it is
                                         inside the drawn face at every theme (inner rim r49 at
                                         border 1, r48 under Contrast) and at every DPI. The Path
                                         is fixed at the face's 100 DIP box and centred in the
                                         Border's smaller inner box, which puts its geometry's
                                         (50,50) on the disc's exact centre for both border
                                         weights. -->
                                    <Path x:Name="DwellRing" Width="100" Height="100"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Data="{Binding DwellProgress, Converter={x:Static ctl:DwellRingGeometryConverter.Instance}}"
                                          Stroke="{StaticResource BrushAccent}" StrokeThickness="4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Opacity="{Binding IsDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Icon per action type. -->
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="{x:Static overlays:QuickActionsGridWindow.TileIconSize}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                        <!-- Label comes from the tile VM, which resolves a preset tile through
                                             the host's label function (QuickActionTileViewModel.Label).
                                             MaxWidth, not the face's inner width: B8b fixup-01 R1 caps the
                                             wrap at 80 DIP so a line's ink stays inside the disc's chord at
                                             the row it is drawn on (the face is a circle, not its square
                                             box). The German fit class B114 now measures the real ink and
                                             the ring against the inner rim, so this number is checked, not
                                             decorative. Long German compounds carry U+00AD (see
                                             strings.de.json) so they can break inside the 80 DIP box. -->
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="{StaticResource FontSizeBodyLarge}" Foreground="{StaticResource BrushTextPrimary}"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   MaxWidth="80"
                                                   Margin="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</overlays:OverlayWindow>
