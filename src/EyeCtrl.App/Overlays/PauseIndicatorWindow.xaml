<overlay:OverlayWindow x:Class="EyeCtrl.App.Overlays.PauseIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:EyeCtrl.App.Overlays"
        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
        AutomationProperties.AutomationId="PauseIndicator_Window"
        Title="{loc:T 'overlays.pause.title'}"
        Topmost="True"
        ShowInTaskbar="False"
        IsClickThrough="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource BrushSurfaceDark}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
</overlay:OverlayWindow>
