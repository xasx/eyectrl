<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.ActivationButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="104" Height="104">
    <!-- The face is built in code-behind (ActivationButtonFace): one static disc whose fill line
         and two content clips move with the dwell. ShowAt sizes this window around the disc and
         centres it on B; these design-time dimensions are only what the designer sees. -->
</overlays:OverlayWindow>
