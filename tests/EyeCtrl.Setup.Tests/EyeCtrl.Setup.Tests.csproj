<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- C9 S6e: the window tests build the real WPF controls and lay them out headlessly. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF's implicit-usings set drops System.IO; several engine tests use it. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EyeCtrl.Setup\EyeCtrl.Setup.csproj" />
    <ProjectReference Include="..\..\src\EyeCtrl.Controls\EyeCtrl.Controls.csproj" />
    <ProjectReference Include="..\..\src\EyeCtrl.Sdk.Wpf\EyeCtrl.Sdk.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied: the hook is one rule, and a second copy is a second rule. Every
         Core-referencing test project installs both; see AssemblyInfo.cs in this project and
         StringTableIsolationTests in EyeCtrl.App.Tests. -->
    <Compile Include="..\TestSupport\StringTableRestoreAttribute.cs"
             Link="TestSupport\StringTableRestoreAttribute.cs" />
    <Compile Include="..\TestSupport\StringTableObserverAttribute.cs"
             Link="TestSupport\StringTableObserverAttribute.cs" />
    <!-- T09's one fit harness and T10's one German draft: the Setup windows measure the real
         buttons and prose at 2.0, and the German draft from the file the App ships. -->
    <Compile Include="..\TestSupport\FitHarness.cs" Link="TestSupport\FitHarness.cs" />
    <Compile Include="..\TestSupport\GermanDraft.cs" Link="TestSupport\GermanDraft.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- X1's real New-FileCatalog v2 fixture: the binary .cat and the exact bytes it hashed.
         Committed so the SIP SHA-256 tag is checked against a real catalog without signing
         anything or touching a certificate. -->
    <None Update="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
