<!--
  XAML view of EyeCtrl.Controls.Theme.Tokens. Values are pulled with {x:Static}
  rather than restated, so drift between the C# and XAML views is structurally
  impossible: there is exactly one literal per colour, in Tokens.cs.
  Guarded by TokenDictionaryTests.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:theme="clr-namespace:EyeCtrl.Controls.Theme">

    <SolidColorBrush x:Key="BrushSurfaceDark"        Color="{x:Static theme:Tokens.SurfaceDark}"/>
    <SolidColorBrush x:Key="BrushSurfaceMedium"      Color="{x:Static theme:Tokens.SurfaceMedium}"/>
    <SolidColorBrush x:Key="BrushSurfaceLight"       Color="{x:Static theme:Tokens.SurfaceLight}"/>
    <SolidColorBrush x:Key="BrushSurfaceKey"         Color="{x:Static theme:Tokens.SurfaceKey}"/>
    <SolidColorBrush x:Key="BrushSurfaceKeyModifier" Color="{x:Static theme:Tokens.SurfaceKeyModifier}"/>
    <SolidColorBrush x:Key="BrushSurfaceKeySwitch"   Color="{x:Static theme:Tokens.SurfaceKeySwitch}"/>
    <SolidColorBrush x:Key="BrushSurfaceKeyActive"   Color="{x:Static theme:Tokens.SurfaceKeyActive}"/>
    <SolidColorBrush x:Key="BrushSurfacePrediction"  Color="{x:Static theme:Tokens.SurfacePrediction}"/>

    <SolidColorBrush x:Key="BrushBorderSubtle"       Color="{x:Static theme:Tokens.BorderSubtle}"/>
    <SolidColorBrush x:Key="BrushBorderFocus"        Color="{x:Static theme:Tokens.BorderFocus}"/>
    <SolidColorBrush x:Key="BrushTextPrimary"        Color="{x:Static theme:Tokens.TextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary"      Color="{x:Static theme:Tokens.TextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextDim"            Color="{x:Static theme:Tokens.TextDim}"/>
    <SolidColorBrush x:Key="BrushMarkerMove"         Color="{x:Static theme:Tokens.MarkerMove}"/>

    <SolidColorBrush x:Key="BrushAccent"             Color="{x:Static theme:Tokens.Accent}"/>
    <SolidColorBrush x:Key="BrushStrokeHalo"         Color="{x:Static theme:Tokens.StrokeHalo}"/>
    <SolidColorBrush x:Key="BrushAccentSuccess"      Color="{x:Static theme:Tokens.AccentSuccess}"/>
    <SolidColorBrush x:Key="BrushAccentWarning"      Color="{x:Static theme:Tokens.AccentWarning}"/>
    <SolidColorBrush x:Key="BrushAccentDanger"       Color="{x:Static theme:Tokens.AccentDanger}"/>
    <SolidColorBrush x:Key="BrushToggleOn"           Color="{x:Static theme:Tokens.ToggleOn}"/>
    <SolidColorBrush x:Key="BrushToggleOff"          Color="{x:Static theme:Tokens.ToggleOff}"/>
    <SolidColorBrush x:Key="BrushModalBackdrop"      Color="{x:Static theme:Tokens.ModalBackdrop}"/>

    <!-- Accent at 10% opacity (derived; see Tokens.BrushAccentDim10). Exposed via x:Static
         because the brush already carries its Opacity and is frozen — a Color binding would lose it. -->
    <x:Static x:Key="BrushAccentDim10" Member="theme:Tokens.BrushAccentDim10"/>

    <!-- The raw pixel value (a double), for code and validator consumers. -->
    <x:Static x:Key="BorderThicknessStandard"
              Member="theme:Tokens.BorderThicknessStandard"/>

    <!-- The XAML-consumable Thickness form. WPF cannot convert a double resource to a
         Thickness, so UniformThicknessExtension does it — declaratively, and in this
         dictionary, so it is drift-guarded by the same test as every brush. Value is bound
         from the token rather than restated, so flipping Tokens.BorderThicknessStandard to
         2 for a high-contrast theme propagates without touching any overlay (§4.4). -->
    <theme:UniformThickness x:Key="StandardBorderThickness"
                            Value="{x:Static theme:Tokens.BorderThicknessStandard}"/>

    <!-- Geometry. Raw doubles for code and the validator; the CornerRadius forms for XAML,
         which cannot convert a double resource. Both are pulled from Tokens with {x:Static}
         so there is exactly one literal per value, in the theme classes.
         NOTE: {x:Static} resolves at PARSE time, before a theme is chosen — so every key
         here must also be written by ThemeResourceApplier.Apply, or it silently stays on
         Midnight. Apply_CoversEveryKeyTheDictionaryDeclares enforces that. See spec §6.6.
         Today every theme declares identical geometry and type, so "stays on Midnight"
         is a mechanism statement, not a currently-observable bug — only
         BorderThicknessStandard (Contrast = 2) actually differs. -->
    <x:Static x:Key="CornerRadiusSmall"    Member="theme:Tokens.CornerRadiusSmall"/>
    <x:Static x:Key="CornerRadiusStandard" Member="theme:Tokens.CornerRadiusStandard"/>
    <x:Static x:Key="CornerRadiusLarge"    Member="theme:Tokens.CornerRadiusLarge"/>
    <x:Static x:Key="CornerRadiusCircle"   Member="theme:Tokens.CornerRadiusCircle"/>

    <x:Static x:Key="SmallCornerRadius"    Member="theme:Tokens.SmallCornerRadius"/>
    <x:Static x:Key="StandardCornerRadius" Member="theme:Tokens.StandardCornerRadius"/>
    <x:Static x:Key="LargeCornerRadius"    Member="theme:Tokens.LargeCornerRadius"/>
    <x:Static x:Key="CircleCornerRadius"   Member="theme:Tokens.CircleCornerRadius"/>

    <!-- Typography. FontFamilyStandard is the raw chain string; FontStandard is the
         FontFamily object. Assigning the wrong one throws at load — no type converter
         runs on a StaticResource assignment. Same parse-time-freeze hazard as the Geometry
         NOTE above applies here too — every key must also be written by
         ThemeResourceApplier.Apply. -->
    <x:Static x:Key="FontFamilyStandard" Member="theme:Tokens.FontFamilyStandard"/>
    <x:Static x:Key="FontStandard"       Member="theme:Tokens.FontStandard"/>
    <x:Static x:Key="FontWeightMedium"   Member="theme:Tokens.FontWeightMedium"/>
    <x:Static x:Key="FontWeightStrong"   Member="theme:Tokens.FontWeightStrong"/>

    <x:Static x:Key="FontSizeBody"      Member="theme:Tokens.FontSizeBody"/>
    <x:Static x:Key="FontSizeBodyLarge" Member="theme:Tokens.FontSizeBodyLarge"/>
    <x:Static x:Key="FontSizeSubtitle"  Member="theme:Tokens.FontSizeSubtitle"/>
    <x:Static x:Key="FontSizeTitle"     Member="theme:Tokens.FontSizeTitle"/>
    <x:Static x:Key="FontSizeDisplay"   Member="theme:Tokens.FontSizeDisplay"/>
</ResourceDictionary>
