<overlay:OverlayWindow x:Class="EyeCtrl.App.Overlays.PauseIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="clr-namespace:EyeCtrl.App.Overlays"
        Title="PauseIndicator"
        Topmost="True"
        ShowInTaskbar="False"
        IsClickThrough="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource BrushSurfaceDark}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
</overlay:OverlayWindow>
