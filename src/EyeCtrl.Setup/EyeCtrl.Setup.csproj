<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      C9 S6a: the install engine. It starts at medium IL (asInvoker) and re-launches only its
      internal elevated sub-verbs with ShellExecute runas. The manifest is explicit rather than
      the SDK default so the asInvoker/uiAccess="false" pair — and, since C9 S6e fixup-04, the
      PerMonitorV2 DPI awareness — is pinned by test.

      Self-contained is a publish concern (S6b's Publish-Signed.ps1 passes
      self-contained true and a win-x64 runtime), matching EyeCtrl.App: the uninstall path must
      still work after a .NET runtime has been removed from the machine.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>EyeCtrl.Setup.Program</StartupObject>
    <!--
      C9 S6e: Setup renders the uninstall choice and the display-only progress/result screens.
      EyeCtrl.Controls supplies the theme tokens; EyeCtrl.Sdk.Wpf supplies the Dwell attached
      properties the choice buttons carry (Invoke mode).
    -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!--
      C9 S6e fixup-03: the progress/result screen shows EyeCtrl's own icon (taskbar button and
      title). The App owns the single source file (tools/EyeCtrl.IconBuilder writes it); linking
      it keeps one copy instead of shipping a second, drift-prone icon. It is embedded as a WPF
      resource, so the single-file publish needs no loose asset.
    -->
    <Resource Include="..\EyeCtrl.App\Assets\eyectrl.ico" Link="Assets\eyectrl.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EyeCtrl.Core\EyeCtrl.Core.csproj" />
    <ProjectReference Include="..\EyeCtrl.Controls\EyeCtrl.Controls.csproj" />
    <ProjectReference Include="..\EyeCtrl.Sdk.Wpf\EyeCtrl.Sdk.Wpf.csproj" />
    <!-- Dwell.SetMode takes the SDK's DwellMode, so the choice buttons name it explicitly. -->
    <ProjectReference Include="..\EyeCtrl.Sdk.Abstractions\EyeCtrl.Sdk.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF's implicit-usings set drops System.IO; the engine's file seams rely on it. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EyeCtrl.Setup.Tests" />
  </ItemGroup>

</Project>
