<Window x:Class="EyeCtrl.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeCtrl Settings" Width="700" Height="550"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16">
            <Button x:Name="SaveButton" Content="Save" Width="100" Height="40"
                    FontSize="16" Margin="8,0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="40"
                    FontSize="16" Margin="8,0" Click="CancelButton_Click"/>
        </StackPanel>
        <!-- Tab control -->
        <TabControl x:Name="SettingsTabs" Margin="8" FontSize="14">
            <!-- Cursor Tab -->
            <TabItem Header="Cursor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Filter Mode" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="FilterModeCombo"/>
                        <TextBlock Text="Smoothing Factor" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="SmoothingSlider" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Snap Radius (px)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="SnapRadiusSlider" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Circle Color (hex)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="CircleColorBox" Width="150" FontSize="14" HorizontalAlignment="Left" Margin="8,4"/>
                        <TextBlock Text="Circle Opacity" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="CircleOpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Circle Thickness" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="CircleThicknessSlider" Minimum="1" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                        <CheckBox x:Name="HighContrastCheck" Content="High Contrast Mode"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Dwell Times Tab -->
            <TabItem Header="Dwell Times">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Fixation Detection (ms)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="FixationDetectionSlider" Minimum="50" Maximum="500" TickFrequency="25" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Activation Button Dwell (ms)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="ActivationDwellSlider" Minimum="200" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Action Menu Dwell (ms)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="ActionMenuDwellSlider" Minimum="200" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Zoom Action Menu Dwell (ms)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="ZoomActionDwellSlider" Minimum="200" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Toolbar Button Dwell (ms)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="ToolbarDwellSlider" Minimum="200" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Keyboard Key Dwell (ms)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="KeyboardKeyDwellSlider" Minimum="100" Maximum="1000" TickFrequency="25" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Prediction Dwell (ms)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="PredictionDwellSlider" Minimum="100" Maximum="1000" TickFrequency="25" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Fixation Radius (px)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="FixationRadiusSlider" Minimum="20" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Zoom Tab -->
            <TabItem Header="Zoom">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <CheckBox x:Name="ZoomEnabledCheck" Content="Enable Zoom Mode"/>
                        <TextBlock Text="Zoom Circle Radius (px)" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="ZoomRadiusSlider" Minimum="50" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="Magnification Level" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="MagnificationSlider" Minimum="1.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Keyboard Tab -->
            <TabItem Header="Keyboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Active Layout" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="LayoutCombo"/>
                        <TextBlock Text="Key Size Multiplier" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="KeySizeSlider" Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <CheckBox x:Name="PredictionEnabledCheck" Content="Enable Word Prediction"/>
                        <TextBlock Text="Language Pack" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="LanguageCombo"/>
                        <TextBlock Text="Screen Edge" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="ScreenEdgeCombo"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Toolbar Tab -->
            <TabItem Header="Toolbar">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <CheckBox x:Name="ToolbarDockedCheck" Content="Dock to Screen Edge"/>
                        <TextBlock Text="Docked Edge" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="DockedEdgeCombo"/>
                        <TextBlock Text="Button Size" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="ToolbarSizeSlider" Minimum="32" Maximum="80" TickFrequency="4" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Theme Tab -->
            <TabItem Header="Theme">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Theme Mode" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="ThemeModeCombo"/>
                        <TextBlock Text="Overlay Opacity" Style="{StaticResource LabelStyle}"/>
                        <Slider x:Name="OverlayOpacitySlider" Minimum="0.3" Maximum="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        <CheckBox x:Name="ThemeHighContrastCheck" Content="High Contrast"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <CheckBox x:Name="StartOnBootCheck" Content="Start on Windows Boot"/>
                        <CheckBox x:Name="StartPausedCheck" Content="Start Paused"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
