<local:OverlayWindow x:Class="EyeCtrl.App.Overlays.CalibrationWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:EyeCtrl.App.Overlays"
                     WindowStyle="None" AllowsTransparency="True"
                     Topmost="True" ShowInTaskbar="False"
                     Background="Transparent"
                     Width="{x:Static SystemParameters.PrimaryScreenWidth}"
                     Height="{x:Static SystemParameters.PrimaryScreenHeight}"
                     Left="0" Top="0"
                     IsClickThrough="True">

    <Grid x:Name="RootGrid">
        <!-- Glass backdrop -->
        <Rectangle x:Name="Backdrop" Fill="{StaticResource BrushModalBackdrop}" Visibility="Collapsed"/>

        <!-- Target area.
             Three layers, drawn back to front:
               ToleranceRing  - the REAL acceptance radius (CalibrationGeometry.BandRadiusPx). Sized in
                                code-behind from the view model, never from a constant here: this ring
                                and the collector's gate must be the same number, and a literal in XAML
                                is exactly how they came to differ by a factor of twelve.
               ProgressRing   - the same circle, drawn thicker/brighter as in-band samples accumulate.
               TargetDot      - the small thing to aim AT, sized from CalibrationSettings.TargetRadiusPixels. -->
        <Canvas x:Name="TargetCanvas" Visibility="Collapsed">
            <Ellipse x:Name="ToleranceRing"
                     Stroke="{StaticResource BrushAccent}" StrokeThickness="2"
                     Opacity="0.35" IsHitTestVisible="False"/>
            <Ellipse x:Name="ProgressRing"
                     Stroke="{StaticResource BrushAccentSuccess}" StrokeThickness="6"
                     Opacity="0" IsHitTestVisible="False"/>
            <Ellipse x:Name="TargetDot" Width="40" Height="40"
                     Fill="{StaticResource BrushAccent}" Opacity="0.8"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform CenterX="20" CenterY="20"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- Progress text -->
        <TextBlock x:Name="ProgressText" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeSubtitle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top" Margin="0,30,0,0" Visibility="Collapsed"/>

        <!-- Completion display -->
        <StackPanel x:Name="CompletionPanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="CompletionSymbol" Text="&#x2713;" FontSize="{StaticResource FontSizeDisplay}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"
                       Foreground="{StaticResource BrushAccentSuccess}"/>
            <TextBlock x:Name="CompletionTitle" Text="Calibration complete"
                       Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeSubtitle}"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="CompletionError" Text=""
                       Foreground="{StaticResource BrushAccentWarning}" FontSize="{StaticResource FontSizeBodyLarge}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="CompletionHint" Text="Auto-dismissing in 3s..."
                       Foreground="{StaticResource BrushTextDim}" FontSize="{StaticResource FontSizeBody}"
                       HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/>
            <!-- Retry / Accept buttons for poor results -->
            <StackPanel x:Name="RetryPanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="RetryButton" Content="Retry" Width="80" Height="32" Margin="0,0,8,0"
                        Foreground="{StaticResource BrushAccentWarning}" Background="Transparent"
                        BorderBrush="{StaticResource BrushAccentWarning}" BorderThickness="{StaticResource StandardBorderThickness}"/>
                <Button x:Name="AcceptButton" Content="Accept anyway" Width="120" Height="32"
                        Foreground="{StaticResource BrushTextSecondary}" Background="Transparent"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}"/>
            </StackPanel>
        </StackPanel>

        <!-- Cancel hint -->
        <TextBlock x:Name="CancelHint" Foreground="{StaticResource BrushTextDim}" FontSize="{StaticResource FontSizeBody}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,20,20" Visibility="Collapsed"
                   Text="Press Esc to cancel"/>
    </Grid>
</local:OverlayWindow>
