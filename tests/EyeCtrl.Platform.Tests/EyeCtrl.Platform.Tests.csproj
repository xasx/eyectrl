<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryImport-generated LPStr marshaling (NativeMethodEntryPointTests) needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EyeCtrl.Platform\EyeCtrl.Platform.csproj" />
  </ItemGroup>

  <!-- Mirror TOBII_AVAILABLE from the Platform project via the shared probe. -->
  <Import Project="..\..\src\Tobii.props" />

  <ItemGroup>
    <!-- Linked, not copied: the hook is one rule, and a second copy is a second rule. Every
         Core-referencing test project installs both; see AssemblyInfo.cs in this project and
         StringTableIsolationTests in EyeCtrl.App.Tests. -->
    <Compile Include="..\TestSupport\StringTableRestoreAttribute.cs"
             Link="TestSupport\StringTableRestoreAttribute.cs" />
    <Compile Include="..\TestSupport\StringTableObserverAttribute.cs"
             Link="TestSupport\StringTableObserverAttribute.cs" />
  </ItemGroup>

</Project>
