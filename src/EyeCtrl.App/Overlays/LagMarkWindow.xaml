<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.LagMarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="LagMark_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        Width="256" Height="192">
    <Grid>
        <!-- The window is the FULL grown extent: the visible button (160 x 96 DIP, on SurfaceLight
             with its label in TextPrimary, like the probe's readable buttons) centred inside a
             48 DIP transparent margin per side, which is the dwell hit area (the probe's D3
             decision). All theme tokens, no literals. -->
        <Border x:Name="ButtonBorder"
                Width="160" Height="96"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource BrushSurfaceLight}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                CornerRadius="{StaticResource StandardCornerRadius}">
            <TextBlock x:Name="LabelText"
                       AutomationProperties.AutomationId="LagMark_Label"
                       Foreground="{StaticResource BrushTextPrimary}"
                       FontSize="{StaticResource FontSizeTitle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</overlays:OverlayWindow>
