<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.TaskSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
        xmlns:ctl="clr-namespace:EyeCtrl.Controls;assembly=EyeCtrl.Controls"
        AutomationProperties.AutomationId="TaskSwitcher_Window"
        Title="{loc:T 'overlays.toolbar.taskSwitcher'}"
        WindowStyle="None" AllowsTransparency="True" Background="{StaticResource BrushSurfaceDark}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        IsClickThrough="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" x:Name="TilesScroll" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center">
            <ItemsControl x:Name="TilesPanel" AutomationProperties.AutomationId="TaskSwitcher_Tiles" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="200" ItemHeight="120"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" Background="{StaticResource BrushSurfaceMedium}" CornerRadius="{StaticResource StandardCornerRadius}" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeBody}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               MaxWidth="180"/>
                                </StackPanel>
                                <!-- Dwell progress: without it a tile gives NO feedback while a
                                     700ms dwell builds, which reads as "not dwellable" (2026-08-17
                                     field report) — every other dwell surface in the app shows this. -->
                                <ProgressBar Grid.Row="1" Value="{Binding DwellProgress}" Maximum="1" Minimum="0"
                                             Height="6" Margin="0,6,0,0"
                                             Foreground="{StaticResource BrushAccent}" Background="Transparent"
                                             BorderThickness="0" Focusable="False" IsHitTestVisible="False"
                                             Opacity="{Binding IsDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="1">
            <TextBlock x:Name="HintText" Text="{loc:T 'overlays.taskSwitcher.hint'}"
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="{StaticResource FontSizeBodyLarge}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
            <!-- Close button — a gaze dwell target (registered + positioned in code-behind),
                 mirroring QuickActionsGridWindow's proven close disc: NOT a WPF Button (gaze
                 produces no mouse clicks, and there is no DwellButtonStyle resource in this
                 app). Dwell progress binds to CloseDwellProgress. The disc is 2 × the shared
                 r50 hit radius (B8), so what is drawn IS what the detector hit-tests; keep
                 Width == Height == TaskSwitcherWindow.CloseButtonSize. -->
            <Border x:Name="CloseButton" Width="100" Height="100" HorizontalAlignment="Right" Margin="12"
                    CornerRadius="{StaticResource CircleCornerRadius}" Background="{StaticResource BrushSurfaceMedium}"
                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}">
                <Grid>
                    <!-- FontSize is set in the constructor from CloseButtonSize × the container
                         ratio — XAML cannot express the multiplication. The glyph TextBlock
                         carries the UIA name (D11): the Border around it has no automation
                         peer, so an explicit name on the glyph is what a screen reader
                         announces instead of "✕". -->
                    <TextBlock x:Name="CloseGlyph" Text="&#x2715;" Foreground="{StaticResource BrushTextPrimary}"
                               AutomationProperties.Name="{loc:T 'overlays.edge.close'}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ProgressBar Minimum="0" Maximum="1"
                                 Value="{Binding CloseDwellProgress}"
                                 Height="4" VerticalAlignment="Bottom"
                                 Background="Transparent" Foreground="{StaticResource BrushAccent}"
                                 BorderThickness="0" Focusable="False" IsHitTestVisible="False"
                                 Opacity="{Binding CloseDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</overlays:OverlayWindow>
