<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.RestartNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        AutomationProperties.AutomationId="RestartNotice_Window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Width="920" Height="300" MinHeight="160">
    <Grid>
        <!-- A notice for a gaze user on a 3840x2400 screen at 200 %: the first line is a title
             (FontSizeTitle, the theme's medium weight), the rest is body at FontSizeSubtitle, and
             the button's label is body-sized. All three are theme tokens, not literals. -->
        <Border x:Name="Banner"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Background="{StaticResource BrushSurfaceDark}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="{StaticResource StandardBorderThickness}"
                CornerRadius="{StaticResource StandardCornerRadius}" Padding="36,26">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           AutomationProperties.AutomationId="RestartNotice_Message"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="{StaticResource FontWeightMedium}" TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText"
                           AutomationProperties.AutomationId="RestartNotice_Body"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <Border x:Name="CloseButton"
                        AutomationProperties.AutomationId="RestartNotice_Close"
                        Width="260" Height="84" HorizontalAlignment="Center" Margin="0,24,0,0"
                        Background="{StaticResource BrushSurfaceKeySwitch}"
                        CornerRadius="{StaticResource StandardCornerRadius}">
                    <TextBlock x:Name="CloseLabel"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</overlays:OverlayWindow>
