<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EyeCtrl.Core\EyeCtrl.Core.csproj" />
    <ProjectReference Include="..\EyeCtrl.LM\EyeCtrl.LM.csproj" />
    <ProjectReference Include="..\EyeCtrl.Platform\EyeCtrl.Platform.csproj" />
    <ProjectReference Include="..\EyeCtrl.ViewModels\EyeCtrl.ViewModels.csproj" />
    <ProjectReference Include="..\EyeCtrl.Contracts\EyeCtrl.Contracts.csproj" />
    <ProjectReference Include="..\EyeCtrl.EyeCare\EyeCtrl.EyeCare.csproj" />
    <ProjectReference Include="..\EyeCtrl.Controls\EyeCtrl.Controls.csproj" />
    <!--
      C9 S6f, coordinator-approved option (a): the App reuses EyeCtrl.Setup's read-only engine
      shapes for the „Erweitert" rows — SetupJson/SetupResult for setup-last.json, InboxScanner's
      newest-package rules and the pinned-thumbprint catalog verification, SetupPaths' constants
      and ElevationPolicyGate's policy read. Referencing the WinExe is inert at rest: Setup has no
      module initializers, so nothing runs until the App constructs its types.
    -->
    <ProjectReference Include="..\EyeCtrl.Setup\EyeCtrl.Setup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Layouts\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Resources\Dictionaries\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Resources\Dictionaries\legacy\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Resources\Dictionaries\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Resources\Completions\*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Resources\Completions\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Resources\Emojis\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Resources\models.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\click.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\dwell-cue.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\status-chime.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!--
      The loose German table and its surface manifest. Link puts them at the output root, "beside
      the App exe" where StringTable/AppExePathResolver look for them, rather than under
      Localization/. ExcludeFromSingleFile is required: a single-file bundle must not swallow them,
      because the German surface set is meant to change per manifest PR without a rebuild.
    -->
    <Content Include="Localization\strings.de.json">
      <Link>strings.de.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Localization\strings.de.manifest.json">
      <Link>strings.de.manifest.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Resource Include="Assets\eyectrl.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\eyectrl.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      C9 S2: the UIAccess build switch. Default false, so every ordinary build, test, CI run
      and F5 session keeps the SDK default manifest (asInvoker, uiAccess="false"). Only an
      installed, signed build passes -p:EyeCtrlUiAccess=true. The Supervisor never uses the
      uiAccess manifest: its csproj sets no ApplicationManifest, and that is pinned by test.
      app.manifest is today's embedded manifest byte for byte; app.uiaccess.manifest differs
      only in the uiAccess attribute.
    -->
    <EyeCtrlUiAccess Condition="'$(EyeCtrlUiAccess)' == ''">false</EyeCtrlUiAccess>
    <ApplicationManifest Condition="'$(EyeCtrlUiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(EyeCtrlUiAccess)' != 'true'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EyeCtrl.App.Tests" />
  </ItemGroup>

</Project>
