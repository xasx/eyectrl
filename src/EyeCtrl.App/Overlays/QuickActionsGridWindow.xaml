<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.QuickActionsGridWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
                        xmlns:loc="clr-namespace:EyeCtrl.Controls.Localization;assembly=EyeCtrl.Controls"
                        xmlns:ctl="clr-namespace:EyeCtrl.Controls;assembly=EyeCtrl.Controls"
                        xmlns:vm="clr-namespace:EyeCtrl.ViewModels;assembly=EyeCtrl.ViewModels"
                        Width="400" Height="600"
                        WindowStyle="None" AllowsTransparency="True"
                        Background="Transparent" Topmost="True"
                        ShowInTaskbar="False">
    <Grid>
        <Border x:Name="RootBorder" Background="{StaticResource BrushSurfaceDark}" CornerRadius="{StaticResource StandardCornerRadius}"
                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Close button — a gaze dwell target (registered + positioned in code-behind).
                     NOT a WPF Button: gaze produces no mouse clicks, and there is no
                     DwellButtonStyle resource in this app. Dwell progress binds to CloseDwellProgress. -->
                <Border x:Name="CloseButton" Grid.Row="0"
                        Width="44" Height="44" HorizontalAlignment="Right"
                        CornerRadius="{StaticResource CircleCornerRadius}" Background="{StaticResource BrushSurfaceMedium}"
                        BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}">
                    <Grid>
                        <!-- FontSize is set in the constructor from CloseButtonSize × the
                             container ratio — XAML cannot express the multiplication.
                             The glyph TextBlock carries the UIA name (D11): the Border around it
                             has no automation peer, so an explicit name on the glyph is what a
                             screen reader announces instead of "✕". -->
                        <TextBlock x:Name="CloseGlyph" Text="&#x2715;" Foreground="{StaticResource BrushTextPrimary}"
                                   AutomationProperties.Name="{loc:T 'overlays.edge.close'}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding CloseDwellProgress}"
                                     Height="4" VerticalAlignment="Bottom"
                                     Background="Transparent" Foreground="{StaticResource BrushAccent}"
                                     BorderThickness="0"
                                     Opacity="{Binding CloseDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                    </Grid>
                </Border>
                <!-- Action tiles -->
                <ItemsControl x:Name="TilesControl" Grid.Row="1" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Rows omitted (defaults to 0 = auto-compute from Columns + item count).
                                 RowCount raises no PropertyChanged, so binding it would go stale on Reload. -->
                            <UniformGrid Columns="{Binding GridColumns, FallbackValue=3}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickActionTileViewModel}">
                            <Border x:Name="TileBorder" Width="120" Height="120"
                                    CornerRadius="{StaticResource StandardCornerRadius}" Background="{StaticResource BrushSurfaceMedium}"
                                    BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="{StaticResource StandardBorderThickness}"
                                    Margin="4">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Icon per action type. -->
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="{x:Static overlays:QuickActionsGridWindow.TileIconSize}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                                        <!-- Label comes from the tile VM, which resolves a preset tile through
                                             the host's label function (QuickActionTileViewModel.Label). -->
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="{StaticResource FontSizeBodyLarge}" Foreground="{StaticResource BrushTextPrimary}"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   Margin="6"/>
                                        <ProgressBar Minimum="0" Maximum="1"
                                                     Value="{Binding DwellProgress}"
                                                     Height="4" VerticalAlignment="Bottom"
                                                     Background="Transparent" Foreground="{StaticResource BrushAccent}"
                                                     BorderThickness="0"
                                                     Opacity="{Binding IsDwellPaused, Converter={x:Static ctl:DwellPausedOpacityConverter.Instance}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</overlays:OverlayWindow>
