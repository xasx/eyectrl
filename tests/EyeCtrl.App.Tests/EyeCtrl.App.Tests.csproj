<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Xunit.StaFact" Version="3.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EyeCtrl.App\EyeCtrl.App.csproj" />
    <ProjectReference Include="..\..\src\EyeCtrl.Core\EyeCtrl.Core.csproj" />
    <ProjectReference Include="..\..\src\EyeCtrl.ViewModels\EyeCtrl.ViewModels.csproj" />
    <ProjectReference Include="..\..\src\EyeCtrl.Contracts\EyeCtrl.Contracts.csproj" />
    <ProjectReference Include="..\..\src\EyeCtrl.Sdk.Abstractions\EyeCtrl.Sdk.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Linked, not copied. TempTestDirectory carries the stale-sweep threshold, and a sweep that
      deletes directories it does not own is the wrong place to keep two copies of a number.
      Same mechanism as EyeCtrl.Core.Tests linking GazeStreamGenerator.cs.
    -->
    <Compile Include="..\TestSupport\TempTestDirectory.cs"
             Link="TestSupport\TempTestDirectory.cs" />
    <!-- Shared valid-tokenizer fixture (same shared-home rule as above); compiled into this
         assembly under its own namespace (EyeCtrl.LM.Tests). -->
    <Compile Include="..\TestSupport\TestTokenizerJson.cs"
             Link="TestSupport\TestTokenizerJson.cs" />
    <Compile Include="..\TestSupport\DpiHelperRestoreAttribute.cs"
             Link="TestSupport\DpiHelperRestoreAttribute.cs" />
    <Compile Include="..\TestSupport\DpiHelperScaleObserverAttribute.cs"
             Link="TestSupport\DpiHelperScaleObserverAttribute.cs" />
    <!-- Same shared-rule link for the string-table restore hook and its observer. -->
    <Compile Include="..\TestSupport\StringTableRestoreAttribute.cs"
             Link="TestSupport\StringTableRestoreAttribute.cs" />
    <Compile Include="..\TestSupport\StringTableObserverAttribute.cs"
             Link="TestSupport\StringTableObserverAttribute.cs" />
    <!-- T09's fit harness: the 2.0 host and the class arithmetic, one copy for every project
         that measures translated text in its real geometry. -->
    <Compile Include="..\TestSupport\FitHarness.cs"
             Link="TestSupport\FitHarness.cs" />
    <Compile Include="..\TestSupport\PseudoLocale.cs"
             Link="TestSupport\PseudoLocale.cs" />
  </ItemGroup>

</Project>
