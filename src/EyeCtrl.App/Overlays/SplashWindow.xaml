<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <Border Background="{StaticResource BrushSurfaceDark}" CornerRadius="{StaticResource LargeCornerRadius}" Padding="40,30">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/eyectrl.ico"
                   Width="64" Height="64"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="EyeCtrl"
                       Foreground="{StaticResource BrushTextPrimary}" FontSize="{StaticResource FontSizeDisplay}" FontWeight="{StaticResource FontWeightMedium}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <ProgressBar IsIndeterminate="True"
                         Width="200" Height="4"
                         Foreground="{StaticResource BrushAccentSuccess}" Background="{StaticResource BrushSurfaceMedium}"
                         BorderThickness="0"/>
        </StackPanel>
    </Border>
</overlays:OverlayWindow>
