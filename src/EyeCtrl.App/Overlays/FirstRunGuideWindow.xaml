<overlays:OverlayWindow x:Class="EyeCtrl.App.Overlays.FirstRunGuideWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:overlays="clr-namespace:EyeCtrl.App.Overlays"
                        IsClickThrough="True"
                        WindowStyle="None" AllowsTransparency="True"
                        ShowInTaskbar="False" ShowActivated="False"
                        Topmost="True" ResizeMode="NoResize">
    <Grid>
        <!-- Owner-approved fullscreen surface (live-check amendment, 2026-11-18): the guide IS the
             screen — an edge-to-edge SurfaceDark surface that hides the desktop entirely. This
             supersedes the fdb92cd0 scrim (the surface itself grounds the guide; there is no
             backdrop/card distinction any more). Interaction is untouched: the window stays
             click-through and joins no dwell target of its own — the dwell targets are the
             VM-registered card visuals the code-behind builds. The approved geometry (the
             DiagnosticGuideMockupFullscreen mockups) is the pinned layout: title 56 DIP top-left
             at margin 64 (right margin ~500 keeps the title clear of the Close host), body 32 DIP
             below it (max width ~1360), action cards 320×190 bottom-right at 64/64, knob cards
             200×160 centered above them, Close card 280×160 alone top-right at 48. -->
        <Border x:Name="Card"
                Background="{DynamicResource BrushSurfaceDark}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <TextBlock x:Name="TitleText" FontSize="56" FontWeight="Medium"
                           Text="{Binding Title}" TextWrapping="Wrap"
                           Margin="64,56,500,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <ContentControl x:Name="ChromeCloseHost"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,48,48,0"/>
                <TextBlock x:Name="BodyText" FontSize="32" TextWrapping="Wrap" MaxWidth="1360"
                           Text="{Binding Body}" Margin="64,190,500,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <ContentControl x:Name="StepContent" Margin="0,0,0,60"/>
                <StackPanel x:Name="KnobRow" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,260"/>
                <StackPanel x:Name="ChoiceRow" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,64,64"/>
            </Grid>
        </Border>
    </Grid>
</overlays:OverlayWindow>
